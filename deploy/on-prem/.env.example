# Copy sang .env (cùng thư mục này) rồi điền giá trị thật. KHÔNG commit .env — chứa bí mật.
# install.ps1 tự sinh các giá trị "đổi giá trị này" bằng chuỗi ngẫu nhiên mạnh — không cần tự gõ
# tay nếu chạy qua script cài đặt.

# ---- Phiên bản ảnh Docker (docs/DECISIONS.md #098) ----
# Phải khớp CHÍNH XÁC với -Version dùng lúc chạy build-and-export.ps1 ở máy dev/CI (tên file
# images/nexamed-<tên>-<version>.tar.gz). install.ps1/install.sh tự điền giá trị này vào đây sau
# khi `docker load` thành công — không cần tự gõ tay nếu cài qua script.
NEXAMED_VERSION=doi-gia-tri-nay-khop-dung-phien-ban-anh-da-build

# ---- PostgreSQL ----
# Role đặc quyền (chủ schema) — CHỈ dùng nội bộ để chạy migration lúc khởi tạo (service `migrate`,
# xem docker-compose.yml), KHÔNG phải role API runtime dùng.
POSTGRES_USER=nexamed
POSTGRES_PASSWORD=doi-gia-tri-nay-mat-khau-manh
POSTGRES_DB=nexamed

# Mật khẩu MỚI cho role `nexamed_app` (role API runtime dùng, không superuser/BYPASSRLS/DELETE) —
# migration tạo role này với mật khẩu mặc định hard-code (chỉ dùng được cho dev), service
# `migrate` tự đổi sang giá trị này lúc khởi tạo (docs/DECISIONS.md #010). Đổi giá trị này thì
# PHẢI khởi động lại toàn bộ stack (`docker compose down && docker compose up -d`) — DATABASE_URL
# ở dưới đọc lại giá trị mới ngay, nhưng container `api` đang chạy vẫn giữ kết nối cũ tới khi khởi
# động lại.
NEXAMED_APP_DB_PASSWORD=doi-gia-tri-nay-mat-khau-manh-it-nhat-16-ky-tu

# ---- API ----
JWT_SECRET=doi-gia-tri-nay-it-nhat-16-ky-tu
ENCRYPTION_KEY=doi-gia-tri-nay-it-nhat-32-ky-tu-dung-de-ma-hoa-cccd

# Origin thật của trang web (trình duyệt nhân viên phòng khám sẽ truy cập) — dùng cho CORS. Nếu
# dùng qua nginx (mặc định, xem docker-compose.yml), web/api CÙNG origin qua reverse proxy nên giá
# trị này chủ yếu để phòng hờ, không phải đường gọi API chính. Ví dụ: http://192.168.1.50 (IP LAN
# của PC/máy chủ) hoặc http://localhost nếu chỉ dùng ngay trên máy đó.
WEB_ORIGIN=http://localhost

# Cookie refresh token KHÔNG đánh dấu Secure — bản on-prem mặc định chạy HTTP thuần (không TLS,
# xem docs/Deploy.md Phần 0.2). Trình duyệt âm thầm bỏ qua cookie Secure trên http://, refresh sẽ
# hỏng không báo lỗi nếu để "true" mà chưa có TLS thật. CHỈ đổi thành "true" khi đã cấu hình HTTPS
# thật trước nginx (ví dụ đặt sau reverse proxy TLS khác, hoặc dùng cho VPS/cloud).
COOKIE_SECURE=false

# ---- Web (nginx) ----
# Cổng HTTP nginx lắng nghe trên MÁY CHỦ (không phải trong container) — đổi nếu PC đã dùng cổng 80
# cho việc khác.
WEB_HTTP_PORT=80

# ---- Backup ----
# Giờ chạy sao lưu hằng ngày (0-23, giờ của container — mặc định UTC, KHÔNG phải giờ Việt Nam trừ
# khi đặt TZ=Asia/Ho_Chi_Minh riêng — cân nhắc chọn giờ ít người dùng hệ thống theo giờ UTC).
BACKUP_HOUR=19
# Số ngày giữ bản sao lưu cũ trước khi tự xoá.
BACKUP_RETENTION_DAYS=14
# Thư mục TRÊN MÁY CHỦ (ngoài container) lưu file sao lưu — NÊN trỏ ra ổ đĩa khác/ổ ngoài, không
# chung ổ với dữ liệu Postgres (nếu ổ chính hỏng thì bản sao lưu cũng mất theo). Mặc định ví dụ
# dưới đây CHỈ phù hợp thử nghiệm — đổi trước khi dùng thật cho pilot.
BACKUP_HOST_DIR=./backup-data