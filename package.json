{
  "name": "nexamed",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* run dev",
    "build": "pnpm --recursive run build",
    "test": "pnpm --recursive run test",
    "lint": "eslint .",
    "typecheck": "pnpm --recursive run typecheck",
    "db:migrate": "pnpm --filter @nexamed/api run db:migrate",
    "db:check-schema": "node scripts/check-mandatory-columns.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.4.0",
      "lodash": "^4.18.1",
      "proxy-addr": "^2.0.8",
      "brace-expansion@<2": "^1.1.20",
      "brace-expansion@>=2 <3": "^2.1.6",
      "brace-expansion@>=5": "^5.0.11",
      "qs": "^6.16.0",
      "body-parser@<2": "^1.20.6",
      "uuid@>=11 <12": "^11.1.1"
    }
  }
}
