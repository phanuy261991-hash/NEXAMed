# Copy sang .env rồi điền giá trị thật. Không commit .env.

# Role app (nexamed_app) — không superuser, không BYPASSRLS, không DELETE. API runtime dùng
# đúng biến này. Role và quyền được tạo trong migration 20260807170922_tenant_context.
DATABASE_URL="postgresql://nexamed_app:nexamed_app@localhost:5433/nexamed?schema=public"

# Role đặc quyền (chủ schema) — CHỈ dùng để chạy migration (pnpm db:migrate / db:deploy),
# KHÔNG dùng cho API runtime. Xem apps/api/scripts/with-migrate-url.mjs.
MIGRATE_DATABASE_URL="postgresql://nexamed:nexamed@localhost:5433/nexamed?schema=public"

JWT_SECRET="change-me-in-each-deployment"
ENCRYPTION_KEY="change-me-32-byte-key-in-each-deployment"
PORT=3000

# Origin của apps/web (CORS, cần credentials:true cho cookie refresh token) — đổi khi triển khai.
WEB_ORIGIN="http://localhost:5173"

# Thư mục lưu file của StoragePort (adapter local-disk) — đặt ngoài web root khi triển khai thật.
STORAGE_DIR="./storage"

# Cờ Secure của cookie refresh token — để trống ở dev (mặc định theo NODE_ENV=development → không
# secure, đúng vì dev chạy http://localhost). Bản on-prem HTTP-only (deploy/on-prem/.env) đặt
# tường minh "false"; bản có TLS (VPS/cloud) đặt "true". Xem docs/Deploy.md Phần 0.2.
# COOKIE_SECURE="false"