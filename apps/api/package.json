{
  "name": "@nexamed/api",
  "private": true,
  "version": "0.0.0",
  "files": ["dist"],
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:migrate": "node scripts/with-migrate-url.mjs migrate dev",
    "db:generate": "prisma generate",
    "db:deploy": "node scripts/with-migrate-url.mjs migrate deploy",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:seed:dev-tenant": "tsx scripts/seed-dev-tenant.ts",
    "db:seed:pilot-tenant": "tsx scripts/seed-pilot-tenant.ts",
    "db:rotate-app-password": "tsx scripts/rotate-app-role-password.ts",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "perf:patient-search": "tsx scripts/perf-patient-search.ts",
    "perf:consultation": "tsx scripts/perf-consultation.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed/index.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^4",
    "@nestjs/throttler": "^6.5.0",
    "@nexamed/core": "workspace:*",
    "@nexamed/shared": "workspace:*",
    "@prisma/client": "^5.22.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.15",
    "@swc/core": "^1.15.47",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.17.6",
    "@types/supertest": "^7.2.1",
    "dotenv": "^16.4.5",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "unplugin-swc": "^1.5.10",
    "vitest": "^2.1.4"
  }
}