// Schema nền tảng — Sprint 1 (xem docs/ERD.md mục 6 "Thứ tự tạo bảng theo sprint").
// Chỉ chứa nhóm bảng "Nền tảng và tenant": tenant, tenant_setting, room, department,
// user_account, role, permission, role_permission, user_role, code_sequence,
// break_glass_session, audit_log, user_session (S1-04, xem docs/DECISIONS.md #019).
// Các bảng patient/appointment/encounter... thuộc Sprint 2-3, chưa thêm ở đây.
//
// RBAC + Data Scope (thay mô hình vai trò cứng) — xem .claude/docs/security-audit.md
// và docs/DECISIONS.md #013-#016.
//
// Quy ước bắt buộc — xem .claude/docs/data-model.md:
// - Mọi bảng nghiệp vụ có đủ 8 cột: id, tenant_id, created_at, updated_at,
//   deleted_at, version, created_by, updated_by.
// - Ngoại lệ: `tenant` không có tenant_id (chính nó là gốc của tenant),
//   `audit_log` không có updated_at/deleted_at/version (append-only).
// - `created_by`/`updated_by` là UUID ghi nhận actor, KHÔNG khai báo @relation
//   (xem docs/DECISIONS.md #005) — tránh vòng phụ thuộc lúc khởi tạo tenant đầu tiên.
// - id dùng uuidv7() (PostgreSQL 18 trở lên, có sẵn trong core) — khớp đúng
//   "UUID v7, sinh phía DB" trong data-model.md. Xem docs/DECISIONS.md #009.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String
  taxCode   String? @map("tax_code")
  address   String?
  licenseNo String? @map("license_no")
  isActive  Boolean @default(true) @map("is_active")

  // Cấu hình "Thông tin phòng khám" (2026-08-13) — phone/email tự do; currency/timezone luôn có
  // giá trị hiển thị (default) nhưng CHƯA nối vào logic tính toán/ngày giờ hệ thống, chỉ lưu
  // trước; logoKey/printLogoKey khoá lưu trên StoragePort, cùng mẫu patient.photoKey.
  phone        String?
  email        String?
  currency     String  @default("VND")
  timezone     String  @default("Asia/Ho_Chi_Minh")
  logoKey      String? @map("logo_key")
  printLogoKey String? @map("print_logo_key")

  // 8 cột bắt buộc (trừ tenant_id — bảng này là gốc của tenant)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenantSettings    TenantSetting[]
  floors            Floor[]
  rooms             Room[]
  examStations      ExamStation[]
  departmentTypes   DepartmentType[]
  departments       Department[]
  userAccounts      UserAccount[]
  roles             Role[]
  rolePermissions   RolePermission[]
  codeSequences     CodeSequence[]
  auditLogs         AuditLog[]
  breakGlassSessions BreakGlassSession[]
  doctorRoomSessions DoctorRoomSession[]
  userSessions      UserSession[]
  patients          Patient[]
  appointments      Appointment[]
  encounters        Encounter[]
  vitalSigns        VitalSign[]
  diagnoses         Diagnosis[]
  clinicalNotes     ClinicalNote[]

  @@map("tenant")
}

model TenantSetting {
  id        String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  key       String
  valueJson Json   @map("value_json") @db.JsonB

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@map("tenant_setting")
}

// "Tầng" (docs/DECISIONS.md #055) — thuần phân loại/tổ chức không gian, TÙY CHỌN (`room.floorId`
// nullable). Phòng khám 1 tầng không tạo dòng nào ở đây, web tự ẩn mọi UI liên quan (cùng nguyên
// tắc "tự ẩn khi ≤1" đã áp dụng cho `room` ở #054) — không có cột "mặc định", suy ra từ số dòng.
model Floor {
  id        String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  name      String
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])
  rooms  Room[]

  // Đích của composite FK (tenant_id, id) từ room.
  @@unique([tenantId, id])
  @@map("floor")
}

model Room {
  id       String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  floorId  String? @map("floor_id") @db.Uuid
  name     String
  isActive Boolean @default(true) @map("is_active")

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  // floor_id nullable — FK chỉ áp khi có giá trị (Postgres MATCH SIMPLE, cùng mẫu
  // user_account.department ở trên).
  floor              Floor?              @relation(fields: [tenantId, floorId], references: [tenantId, id])
  appointments       Appointment[]
  doctorRoomSessions DoctorRoomSession[]
  examStations       ExamStation[]

  // Đích của composite FK (tenant_id, id) từ appointment (S2-05), doctor_room_session, exam_station.
  @@unique([tenantId, id])
  @@map("room")
}

// "Bàn khám / Ghế" (docs/DECISIONS.md #055) — cấp con của `room`, THUẦN MÔ TẢ/tổ chức (ví dụ
// phòng khám nha nhiều ghế trong 1 phòng). KHÔNG phải đơn vị điều phối — "phòng làm việc hôm nay"
// của bác sĩ (`doctor_room_session`) và `appointment.room_id` vẫn dừng ở cấp `room`, không xuống
// tới đây (đã hỏi và chốt qua AskUserQuestion trước khi thiết kế).
model ExamStation {
  id        String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  roomId    String  @map("room_id") @db.Uuid
  name      String
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])
  room   Room   @relation(fields: [tenantId, roomId], references: [tenantId, id])

  @@map("exam_station")
}

// "Phòng làm việc hôm nay" của bác sĩ — thuần vận hành/định tuyến UI (KHÔNG phải dữ liệu lâm
// sàng, không dùng để lọc data_scope của encounter/hàng đợi khám, xem docs/DECISIONS.md).
// 1 dòng/bác sĩ/ngày lịch Việt Nam (workDate) — partial unique viết ở migration (cùng lý do
// user_role/patient.national_id_hash không khai `@@unique` được trong Prisma: điều kiện WHERE).
model DoctorRoomSession {
  id       String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  doctorId String   @map("doctor_id") @db.Uuid
  roomId   String   @map("room_id") @db.Uuid
  workDate DateTime @map("work_date") @db.Date

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  doctor UserAccount @relation(fields: [tenantId, doctorId], references: [tenantId, id])
  room   Room        @relation(fields: [tenantId, roomId], references: [tenantId, id])

  @@map("doctor_room_session")
}

// Khoa/phòng trong 1 tenant — phục vụ Data Scope `department` (security-audit.md).
// v1 phần lớn phòng khám không dùng (1-3 bác sĩ, không chia khoa) nhưng bảng luôn tồn tại.
// "Loại Khoa/Phòng" (mở rộng ADM-01, yêu cầu chủ dự án 2026-08-20) — cấp cha TÙY CHỌN của
// `department`, THUẦN phân loại/tổ chức, đúng khuôn `Floor` (cấp cha tùy chọn của `Room`).
model DepartmentType {
  id       String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  name     String
  isActive Boolean @default(true) @map("is_active")

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  departments Department[]

  // Đích của composite FK (tenant_id, id) từ department.
  @@unique([tenantId, id])
  @@map("department_type")
}

model Department {
  id               String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  departmentTypeId String? @map("department_type_id") @db.Uuid
  // Mã hiển thị tự sinh qua CodeSequenceRepository (prefix "KP"), đúng khuôn patient_code/
  // employee_code — KHÔNG nhập tay. Nullable: phòng ban tạo trước tính năng này không backfill.
  code     String?
  name     String
  // Mở rộng ADM-01 (2026-08-20) — danh mục Khoa/Phòng quản lý được qua UI (Thêm/Sửa/Ẩn), cùng
  // khuôn Room (isActive, không phải soft-delete deletedAt — giữ nguyên lịch sử gán trên
  // user_account.department_id, chỉ ẩn khỏi Combobox chọn mới).
  isActive Boolean @default(true) @map("is_active")

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  // department_type_id nullable — FK chỉ áp khi có giá trị (Postgres MATCH SIMPLE, cùng mẫu room.floor).
  departmentType DepartmentType? @relation(fields: [tenantId, departmentTypeId], references: [tenantId, id])
  userAccounts UserAccount[]

  // Đích của composite FK (tenant_id, id) từ user_account.
  @@unique([tenantId, id])
  @@map("department")
}

model UserAccount {
  id           String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  departmentId String? @map("department_id") @db.Uuid
  username     String
  passwordHash String  @map("password_hash")
  fullName     String  @map("full_name")
  licenseNo    String? @map("license_no")
  isActive     Boolean @default(true) @map("is_active")

  // Hồ sơ nhân sự (mở rộng ADM-01) — tất cả nullable, tài khoản cũ trước tính năng này để trống,
  // không backfill (chưa có tenant production). employeeCode sinh tự động qua code_sequence
  // (prefix "NV") CHỈ cho tài khoản tạo mới, không unique cứng ở DB (tài khoản cũ đều NULL, có
  // thể trùng NULL — Postgres không tính NULL trùng NULL trong UNIQUE thường).
  employeeCode          String?  @map("employee_code")
  phone                 String?
  personalEmail         String?  @map("personal_email")
  companyEmail          String?  @map("company_email")
  // 4 cột dưới lưu `code` của reference_catalog (category tương ứng) — không FK cứng, cùng khuôn
  // patient.ethnicity/occupation (xem comment model ReferenceCatalog).
  academicTitleCode     String?  @map("academic_title_code")
  positionCode          String?  @map("position_code")
  employmentStatusCode  String?  @map("employment_status_code")
  employmentTypeCode    String?  @map("employment_type_code")
  // Được ký HSBA — CHỈ lưu metadata ở v1, chưa gắn logic chặn nào (chữ ký số/chữ ký logic thật là
  // Sprint 5, ENC-04 — đúng tinh thần CLAUDE.md "chữ ký số chưa triển khai ở v1").
  canSignMedicalRecord  Boolean  @default(false) @map("can_sign_medical_record")
  // Bắt tài khoản đổi mật khẩu ở lần đăng nhập kế tiếp — enforce thật qua `POST /auth/change-
  // password` + chặn điều hướng ở web (`RequireAuth`), xem auth.service.ts.
  mustChangePassword    Boolean  @default(false) @map("must_change_password")

  // Khoá tài khoản tạm sau 5 lần đăng nhập sai trong 15 phút — xem
  // .claude/docs/security-audit.md mục Xác thực, packages/core/src/iam/lockout.ts.
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lastFailedLoginAt DateTime? @map("last_failed_login_at") @db.Timestamptz(6)
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(6)

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  // Composite FK (tenant_id, department_id) -> department(tenant_id, id): department_id
  // nullable nên FK chỉ áp khi có giá trị (Postgres MATCH SIMPLE — xem docs/DECISIONS.md).
  department Department? @relation(fields: [tenantId, departmentId], references: [tenantId, id])
  userRoles  UserRole[]
  sessions   UserSession[]
  appointmentsAsDoctor Appointment[] @relation("AppointmentDoctor")
  encountersAsDoctor   Encounter[]   @relation("EncounterDoctor")
  roomSessionsAsDoctor DoctorRoomSession[]

  // Đích của composite FK (tenant_id, id) từ user_role — chống trỏ chéo tenant (C5 trong ERD.md).
  @@unique([tenantId, id])
  @@unique([tenantId, username])
  @@map("user_account")
}

// Phiên refresh token — cho phép "xoay vòng mỗi lần refresh" (rotation) + phát hiện token bị
// đánh cắp (reuse detection): mỗi lần refresh, phiên cũ bị soft-delete (deleted_reason =
// 'rotated') và trỏ replacedBySessionId sang phiên mới. Nếu một hash đã bị rotate còn bị dùng
// lại, đó là dấu hiệu token rò rỉ — service thu hồi toàn bộ phiên của user (deleted_reason =
// 'reuse_detected'). Thu hồi = soft delete, dùng đúng pattern deleted_at/deleted_reason sẵn có
// trong hệ thống, không cần cột "revoked" riêng. Xem .claude/docs/security-audit.md mục Xác
// thực, docs/DECISIONS.md #019.
model UserSession {
  id               String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  userId           String  @map("user_id") @db.Uuid
  refreshTokenHash String  @unique @map("refresh_token_hash")
  issuedAt         DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt        DateTime @map("expires_at") @db.Timestamptz(6)
  // Composite FK (tenant_id, replaced_by_session_id) -> user_session(tenant_id, id): phiên kế
  // tiếp trong chuỗi rotation, null nếu đây vẫn là phiên hiện hành hoặc đã bị thu hồi thẳng
  // (logout/reuse_detected/role_changed) chứ không phải rotate.
  replacedBySessionId String? @map("replaced_by_session_id") @db.Uuid
  ip                   String? @db.Text
  userAgent            String? @map("user_agent") @db.Text

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])
  // Composite FK (tenant_id, user_id) -> user_account(tenant_id, id): chống trỏ chéo tenant.
  user        UserAccount   @relation(fields: [tenantId, userId], references: [tenantId, id])
  replacedBy  UserSession?  @relation("SessionRotation", fields: [tenantId, replacedBySessionId], references: [tenantId, id])
  previousOf  UserSession[] @relation("SessionRotation")

  @@unique([tenantId, id])
  @@map("user_session")
}

// Vai trò theo tenant (không còn enum cứng) — clinic_admin tạo thêm được vai trò tuỳ biến.
// Seed 5 vai trò mặc định (is_system_default = true) lúc tạo tenant — xem prisma/seed/.
model Role {
  id              String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String  @map("tenant_id") @db.Uuid
  name            String
  isSystemDefault Boolean @default(false) @map("is_system_default")

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  // Đích của composite FK (tenant_id, id) từ user_role/role_permission.
  @@unique([tenantId, id])
  // UNIQUE(tenant_id, name) đổi từ thường sang PARTIAL (WHERE deleted_at IS NULL) ở ADM-07 (tạo
  // vai trò tuỳ biến, migration `20260820090000_role_management`) — unique thường (khai báo cũ
  // `@@unique([tenantId, name])`, từ migration `20260808015619_rbac_data_scope`) sẽ chặn tạo lại
  // đúng tên vai trò đã từng bị ẩn (soft-delete) trước đó. Không khai báo được `@@unique` có
  // `WHERE` bằng Prisma schema (giống C3 `patient.national_id_hash`, `user_role`) — viết raw SQL
  // trong migration, không khai báo ở đây.
  @@map("role")
}

// Danh mục hành động — TOÀN HỆ THỐNG (giống icd10_catalog), không có tenant_id, seed cố
// định theo code, không do phòng khám tự định nghĩa. Định dạng "<module>.<action>".
model Permission {
  id          String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  module      String
  action      String
  description String

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permission")
}

enum ReferenceCatalogCategory {
  ETHNICITY
  NATIONALITY
  // Sprint 3, phần Tiếp nhận — Nguồn khách hàng / Loại khám, quản lý ở Cấu hình, tái dùng nguyên
  // bảng này thay vì tạo bảng riêng (docs/DECISIONS.md).
  PATIENT_SOURCE
  EXAM_TYPE
  // Thiết kế lại "Tiếp nhận bệnh nhân" (mockup đã duyệt) — Loại tiếp nhận / Hình thức khám / Lý do
  // ưu tiên / Loại giá dịch vụ, cùng lý do tái dùng bảng này (docs/DECISIONS.md).
  RECEPTION_TYPE
  EXAM_FORM
  PRIORITY_REASON
  PRICE_TYPE
  // Nghề nghiệp — đảo ngược tiếp phần `occupation` của docs/DECISIONS.md #034 (trước đây cố ý để
  // text tự do, không danh mục hoá). Không có nguồn dữ liệu chính thức (khác Dân tộc/Quốc tịch) —
  // không seed cứng, quản lý qua UI (thêm/sửa/ẩn) như PATIENT_SOURCE/EXAM_TYPE.
  OCCUPATION
  // Danh mục quản lý tài khoản nhân sự (mở rộng ADM-01) — Học vị/học hàm và Chức danh không có
  // nguồn dữ liệu chính thức, không seed cứng (cùng lý do OCCUPATION). Trạng thái làm việc và
  // Hình thức làm việc CÓ seed 3/4 giá trị mặc định (packages/core/src/reference-catalog/data.ts)
  // vì chủ dự án đã cho sẵn giá trị chuẩn, nhưng vẫn quản lý được qua UI (clinic_admin thêm được
  // trạng thái/hình thức khác nếu cần).
  ACADEMIC_TITLE
  STAFF_POSITION
  EMPLOYMENT_STATUS
  EMPLOYMENT_TYPE

  @@map("reference_catalog_category")
}

// Danh mục dùng chung — TOÀN HỆ THỐNG (cùng bản chất permission/icd10_catalog), không có
// tenant_id, không đủ 8 cột bắt buộc, không version (rủi ro ghi đè đồng thời thấp — clinic_admin
// sửa không thường xuyên). Quản lý được qua API (create/update/deactivate) bởi clinic_admin
// (reference_catalog.manage), khác `permission` — vì vậy GRANT mặc định của nexamed_app (SELECT/
// INSERT/UPDATE, đã cấp qua ALTER DEFAULT PRIVILEGES) được giữ nguyên, không REVOKE gì thêm.
// DELETE đã bị revoke toàn cục cho nexamed_app (migration *_tenant_context) — "xoá" thật ra là
// isActive=false (soft), không phải SQL DELETE. `code` là mã chính thức (dân tộc: "1".."54" theo
// Tổng cục Thống kê; quốc tịch: ISO 3166-1 alpha-3) — đây là giá trị lưu trên
// patient.ethnicity/patient.nationality/patient.occupation (docs/DECISIONS.md, đảo ngược #034
// phần ethnicity/nationality; occupation đảo ngược tiếp sau đó — xem entry OCCUPATION).
model ReferenceCatalog {
  id        String                    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  category  ReferenceCatalogCategory
  code      String
  name      String
  sortOrder Int                       @default(0) @map("sort_order")
  isActive  Boolean                   @default(true) @map("is_active")
  // Giá tham khảo (đồng) — CHỈ có ý nghĩa với category EXAM_TYPE, NULL với category khác. v1 chỉ
  // lưu để hiển thị, không tính toán/xuất hoá đơn (viện phí ngoài phạm vi CLAUDE.md).
  price     BigInt?
  // Đơn vị (ví dụ "Lượt", "Buổi") — cùng bản chất `price`, chỉ có ý nghĩa với category EXAM_TYPE.
  unit      String?
  // Tự động vô hiệu hoá tài khoản khi được chọn làm Trạng thái làm việc của một nhân viên — CHỈ
  // có ý nghĩa với category EMPLOYMENT_STATUS (giống price/unit chỉ có ý nghĩa với EXAM_TYPE).
  // Tách thành cột riêng thay vì so khớp `code` cố định ("NGHI_VIEC"...) vì `code` sửa được qua
  // UI (ReferenceCatalogPane) — so khớp chuỗi sẽ hỏng ngầm khi admin đổi mã.
  deactivatesAccount Boolean @default(false) @map("deactivates_account")

  @@unique([category, code])
  @@map("reference_catalog")
}

// Danh mục hành chính Tỉnh/Phường-Xã — TOÀN HỆ THỐNG (cùng bản chất icd10_catalog/permission),
// không tenant_id, không đủ 8 cột bắt buộc, không version/is_active. Read-only lúc chạy (khác
// reference_catalog — không có endpoint create/update/delete): dữ liệu hành chính chính thức Bộ
// Nội vụ, không ai cần sửa qua UI. `code` phường/xã 8 chữ số duy nhất toàn quốc (không chỉ trong
// phạm vi tỉnh — đã xác nhận không trùng khi soạn seed), nên PK thẳng bằng `code`, không cần FK
// hỗn hợp province_code trong PK. Xem docs/DECISIONS.md #038.
model Province {
  code      String @id
  name      String
  sortOrder Int    @default(0) @map("sort_order")

  wards Ward[]

  @@map("province")
}

model Ward {
  code         String @id
  name         String
  provinceCode String @map("province_code")
  sortOrder    Int    @default(0) @map("sort_order")

  province Province @relation(fields: [provinceCode], references: [code])

  @@index([provinceCode])
  @@map("ward")
}

enum Icd10GenderRestriction {
  male
  female

  @@map("icd10_gender_restriction")
}

enum Icd10UsageRestriction {
  limited_primary
  not_primary

  @@map("icd10_usage_restriction")
}

// Danh mục ICD-10 — TOÀN HỆ THỐNG (cùng bản chất province/ward/permission), không tenant_id,
// không đủ 8 cột bắt buộc, không version. Read-only lúc chạy (khác reference_catalog — không có
// endpoint create/update/delete): danh mục Bộ Y tế, seed từ file chính thức chủ dự án cung cấp
// (docs/data/icd10-chuong-1.md). Chỉ seed Chương I trước (S3-01, mở khoá một phần) — các chương
// khác bổ sung dần sau qua cùng cơ chế seed idempotent (skipDuplicates), không migration lại.
// `searchKey` tái dùng nguyên hàm `nexamed_unaccent_lower()` đã có từ patient (S2-02) — không định
// nghĩa lại. `code === groupCode` đánh dấu dòng "Nhóm bệnh" (3 ký tự); các dòng khác là mã chi
// tiết 4-5 ký tự thuộc nhóm đó.
model Icd10Catalog {
  code      String  @id
  nameVi    String  @map("name_vi")
  nameEn    String? @map("name_en")
  // Generated column ở DB (GENERATED ALWAYS AS ... STORED) — không truyền lúc create/update.
  searchKey String? @map("search_key")

  chapterCode String @map("chapter_code")
  chapterName String @map("chapter_name")
  blockCode   String @map("block_code")
  blockName   String @map("block_name")
  groupCode   String @map("group_code")
  groupName   String @map("group_name")

  isBillable        Boolean                  @default(true) @map("is_billable")
  genderRestriction Icd10GenderRestriction?  @map("gender_restriction")
  usageRestriction  Icd10UsageRestriction?   @map("usage_restriction")
  whoNote           String?                  @map("who_note")

  diagnoses Diagnosis[]

  @@index([chapterCode])
  @@index([groupCode])
  @@map("icd10_catalog")
}

enum DataScope {
  none
  personal
  department
  global

  @@map("data_scope")
}

// Ma trận phân quyền: (role, permission) -> data_scope. Xem security-audit.md để biết
// bảng giá trị mặc định seed cho 5 vai trò hệ thống.
model RolePermission {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  permissionId String    @map("permission_id") @db.Uuid
  dataScope    DataScope @map("data_scope")

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])
  // Composite FK (tenant_id, role_id) -> role(tenant_id, id): chống trỏ chéo tenant.
  role       Role       @relation(fields: [tenantId, roleId], references: [tenantId, id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([tenantId, roleId, permissionId])
  @@map("role_permission")
}

model UserRole {
  id       String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  roleId   String @map("role_id") @db.Uuid

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  // Composite FK (tenant_id, user_id) -> user_account(tenant_id, id) và
  // (tenant_id, role_id) -> role(tenant_id, id): không thể trỏ sang tenant khác kể cả
  // khi code service sai.
  userAccount UserAccount @relation(fields: [tenantId, userId], references: [tenantId, id])
  role        Role        @relation(fields: [tenantId, roleId], references: [tenantId, id])

  // UNIQUE(tenant_id, user_id, role_id) là PARTIAL (WHERE deleted_at IS NULL) — thêm ở S2-07 khi
  // gán lại vai trò (soft-delete gán cũ + tạo dòng mới) mới thật sự cần: unique thường sẽ chặn
  // gán lại đúng vai trò đã từng bị gỡ trước đó (dòng cũ đã soft-delete vẫn tính vào unique
  // thường). Không khai báo được `@@unique` có `WHERE` bằng Prisma schema (giống C3
  // `patient.national_id_hash`) — viết raw SQL trong migration, không khai báo ở đây.
  @@map("user_role")
}

// Phiên "phá kính" — vượt quyền tạm thời khi bị chặn bởi data_scope. Append-only như
// audit_log (không updated_at/deleted_at/version/created_by/updated_by) — xem
// security-audit.md mục Break-glass.
model BreakGlassSession {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  reason     String
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("break_glass_session")
}

model CodeSequence {
  id           String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  prefix       String
  currentValue BigInt @default(0) @map("current_value")

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, prefix])
  @@map("code_sequence")
}

// Hồ sơ hành chính bệnh nhân (S2-01, PAT-01) — xem .claude/docs/data-model.md, docs/ERD.md.
// `nationalIdEnc`/`nationalIdHash`: mã hoá AES-256-GCM + hash HMAC-SHA256 tra trùng
// (apps/api/src/infrastructure/crypto/pii-encryption.ts), CCCD tuỳ chọn (PAT-01) nên cả hai
// nullable. `addressJson`/`identityVerifiedAt`: thêm ở S2-01 để vá lệch ERD.md/data-model.md
// (docs/DECISIONS.md #024) — `identityVerifiedAt` luôn null ở v1, chuẩn bị cho liên-tenant v3+
// cùng `globalPatientRef`. Unique `(tenantId, nationalIdHash)` WHERE NOT NULL không biểu diễn
// được bằng Prisma schema (partial unique index) — thêm bằng raw SQL trong migration.
model Patient {
  id                 String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  patientCode        String    @map("patient_code")
  fullName           String    @map("full_name")
  dob                DateTime  @db.Date
  gender             String
  phone              String
  nationalIdEnc      Bytes?    @map("national_id_enc")
  nationalIdHash     String?   @map("national_id_hash")
  addressJson        Json?     @map("address_json") @db.JsonB
  allergyNote        String?   @map("allergy_note")
  mergedIntoId       String?   @map("merged_into_id") @db.Uuid
  globalPatientRef   String?   @map("global_patient_ref") @db.Uuid
  identityVerifiedAt DateTime? @map("identity_verified_at") @db.Timestamptz(6)
  // Mở rộng hồ sơ hành chính (docs/DECISIONS.md #034) — tất cả nullable, không backfill, không
  // ràng buộc DB mới. `insuranceNumber` độc lập với module `insurance_card` (S2-04, chưa làm) —
  // chỉ lưu/hiển thị.
  photoKey                String?   @map("photo_key")
  nationalIdIssuedAt      DateTime? @map("national_id_issued_at") @db.Date
  nationalIdIssuedPlace   String?   @map("national_id_issued_place")
  // `ethnicity`/`nationality`/`occupation` lưu CODE tham chiếu `reference_catalog` (category
  // ETHNICITY/NATIONALITY/OCCUPATION) — không FK cứng (cùng lý do reference_catalog không có
  // tenant_id, xem comment model ReferenceCatalog). Vẫn String? thuần để không chặn hồ sơ cũ có
  // giá trị text tự do trước khi danh mục hoá (web tự chèn "legacy value" vào Combobox).
  ethnicity               String?
  nationality             String?
  occupation              String?
  insuranceNumber         String?   @map("insurance_number")
  relativeFullName        String?   @map("relative_full_name")
  relativeRelationship    String?   @map("relative_relationship")
  relativePhone           String?   @map("relative_phone")
  relativeAddress         String?   @map("relative_address")
  // Cột dẫn xuất (S2-02, PAT-02) — Postgres GENERATED ALWAYS AS (...) STORED từ full_name (bỏ
  // dấu + viết thường qua hàm nexamed_unaccent_lower(), xem migration `*_patient_search`).
  // KHÔNG bao giờ ghi trực tiếp field này từ Prisma (DB tự tính, ghi vào sẽ lỗi) —
  // PatientRepository không đưa searchKey vào bất kỳ `data: {...}` create/update nào. Khai báo
  // `String?` (không phải `String`) dù thực tế DB không bao giờ null (full_name NOT NULL) — chỉ
  // để Prisma không bắt buộc field này trong `PatientCreateInput`/`PatientUncheckedCreateInput`
  // (Prisma không có khái niệm "generated column, chỉ đọc" nên coi mọi field NOT NULL là bắt
  // buộc phải truyền lúc tạo).
  searchKey          String?   @map("search_key")

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])
  // Composite FK (tenant_id, merged_into_id) -> patient(tenant_id, id): luồng gộp hồ sơ trùng
  // (PAT-04, chưa hiện thực ở S2-01) — bản ghi nguồn không xoá, chỉ trỏ sang bản ghi đích.
  mergedInto Patient?  @relation("PatientMerge", fields: [tenantId, mergedIntoId], references: [tenantId, id])
  mergedFrom Patient[] @relation("PatientMerge")
  appointments Appointment[]
  encounters   Encounter[]

  // Đích của composite FK (tenant_id, id) từ appointment/encounter (S2-05, S3) sau này.
  @@unique([tenantId, id])
  @@unique([tenantId, patientCode])
  @@map("patient")
}

enum AppointmentStatus {
  SCHEDULED
  CANCELLED
  NO_SHOW
  CONVERTED
  // Dời lịch (yêu cầu chủ dự án 2026-08-18) — lịch cũ chuyển sang trạng thái này, KHÔNG sửa tại
  // chỗ như bản PATCH reschedule cũ (S2-09). Một lịch mới được tạo riêng cho ngày/giờ mới, trỏ về
  // lịch này qua `rescheduledFromId` (xem dưới) — cùng khuôn `prescription.supersedesId`.
  RESCHEDULED

  @@map("appointment_status")
}

enum AppointmentSource {
  walk_in
  phone
  online

  @@map("appointment_source")
}

// Lịch hẹn (S2-05, APP-01/02/03) — xem .claude/docs/clinical-workflow.md mục "Đặt lịch",
// docs/ERD.md mục 3.3/4. `roomId` nullable: đặt lịch qua điện thoại/online chưa chắc gán phòng
// ngay (module `tenant`/cấu hình phòng là S2-07, chưa tồn tại lúc này) — không phải yêu cầu đã
// chốt, chỉ là lựa chọn ít ràng buộc hơn, dễ siết lại (thêm NOT NULL) hơn là nới lỏng sau.
// Chống trùng giờ bác sĩ (C2, docs/ERD.md mục 4) dùng EXCLUDE USING gist — Prisma không hỗ trợ
// cú pháp EXCLUDE constraint nên thêm bằng raw SQL trong migration, không khai báo được ở đây.
//
// Đổi mô hình đặt lịch (docs/DECISIONS.md #032): không tạo/gắn `patient` lúc đặt — chỉ ghi nhận
// `fullName`/`phone`/`reason` trực tiếp trên `appointment` ("lead capture"), có `bookingCode` để
// khách trình lúc đến. `patientId` chuyển thành nullable — để sẵn cho Tiếp nhận (Sprint 3) gắn
// hồ sơ `patient` thật lúc check-in, chưa có luồng nào ghi giá trị này ở v1 hiện tại.
model Appointment {
  id              String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  patientId       String?           @map("patient_id") @db.Uuid
  doctorId        String            @map("doctor_id") @db.Uuid
  roomId          String?           @map("room_id") @db.Uuid
  bookingCode     String            @map("booking_code")
  fullName        String            @map("full_name")
  phone           String
  reason          String?
  scheduledAt     DateTime          @map("scheduled_at") @db.Timestamptz(6)
  durationMinutes Int               @map("duration_minutes")
  status          AppointmentStatus @default(SCHEDULED)
  source          AppointmentSource
  cancelReason    String?           @map("cancel_reason")
  // Dời lịch (2026-08-18): lịch MỚI trỏ về lịch CŨ đã bị đánh dấu RESCHEDULED — cùng hướng trỏ
  // với `prescription.supersedesId`/`patient.mergedIntoId` (bản mới/đích trỏ về bản cũ/nguồn,
  // không phải ngược lại). Không có unique constraint (kể cả partial) — cùng lựa chọn đã có ở
  // `patient.mergedIntoId`, chấp nhận rủi ro lý thuyết vì service là nơi duy nhất ghi cột này.
  rescheduledFromId String? @map("rescheduled_from_id") @db.Uuid

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])
  // Composite FK (tenant_id, patient_id/doctor_id/room_id) -> ...(tenant_id, id): chống trỏ chéo
  // tenant (C5, docs/ERD.md mục 4), room_id/patient_id nullable nên FK chỉ áp khi có giá trị.
  patient Patient?    @relation(fields: [tenantId, patientId], references: [tenantId, id])
  doctor  UserAccount @relation("AppointmentDoctor", fields: [tenantId, doctorId], references: [tenantId, id])
  room    Room?       @relation(fields: [tenantId, roomId], references: [tenantId, id])
  // Composite FK (tenant_id, rescheduled_from_id) -> appointment(tenant_id, id) — cùng khuôn
  // Patient.mergedInto/mergedFrom (self-relation, phía "nhiều" khai List vì Prisma không biết đây
  // thực ra là 1-1 khi không có unique constraint).
  rescheduledFrom Appointment?  @relation("AppointmentReschedule", fields: [tenantId, rescheduledFromId], references: [tenantId, id])
  rescheduledTo   Appointment[] @relation("AppointmentReschedule")
  // Prisma bắt buộc khai báo back-relation cho field `Encounter.appointment` — khai dạng LIST
  // (không phải `Encounter?`) vì `appointmentId` không có `@unique` ở phía Prisma (constraint thật
  // là partial unique index raw SQL trên `encounter(tenant_id, appointment_id)`, xem migration —
  // cùng lý do `patient.nationalIdHash` không khai `@unique`). Prisma không biết đây thực ra là
  // quan hệ một-một; DB tự ép đúng ngữ nghĩa đó. Không có nơi nào cần điều hướng qua field này —
  // ReceptionRepository/EncounterRepository tự truy vấn theo `appointmentId`.
  encounters Encounter[]

  @@unique([tenantId, id])
  @@unique([tenantId, bookingCode])
  @@index([tenantId, phone])
  @@map("appointment")
}

enum EncounterStatus {
  SCHEDULED
  CHECKED_IN
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW

  @@map("encounter_status")
}

// S3-05→07 (Khám bệnh) — .claude/docs/clinical-workflow.md mục "Khám bệnh": "Bắt buộc có ít nhất
// một `diagnosis` với `type = primary`". Đúng một PRIMARY/encounter ép bằng unique partial index
// raw SQL (C10, docs/ERD.md) — không biểu diễn được ở Prisma, xem comment trong model Diagnosis.
enum DiagnosisType {
  PRIMARY
  SECONDARY

  @@map("diagnosis_type")
}

// Thay thế 4 mục SOAP (S/O/A/P) bằng 8 mục theo nhóm "Tiền sử"/"Thăm khám" — yêu cầu chủ dự án
// 2026-08-20, xem docs/DECISIONS.md (entry sau #059). PERSONAL_HISTORY/FAMILY_HISTORY thuộc nhóm
// "Tiền sử" (hiển thị dạng khung/box riêng ở web, KHÔNG gồm dị ứng — dị ứng đọc/ghi thẳng
// patient.allergyNote, không qua bảng này). REASON_FOR_VISIT/ILLNESS_PROGRESS/
// PRELIMINARY_DIAGNOSIS/GENERAL_EXAM/REGIONAL_EXAM thuộc nhóm "Thăm khám". PLAN để sẵn cho tab
// "Kế hoạch điều trị & hẹn tái khám" (chưa xây, xem EncounterConsultationPage.tsx TABS).
enum ClinicalNoteSection {
  PERSONAL_HISTORY
  FAMILY_HISTORY
  REASON_FOR_VISIT
  ILLNESS_PROGRESS
  PRELIMINARY_DIAGNOSIS
  GENERAL_EXAM
  REGIONAL_EXAM
  PLAN

  @@map("clinical_note_section")
}

// Lượt khám (Sprint 3, REC-01→03) — xem .claude/docs/clinical-workflow.md mục "Tiếp nhận
// (check-in)", docs/ERD.md mục 3.3. Bảng trung tâm: sinh hiệu/chẩn đoán/ghi chú/đơn thuốc đều trỏ
// về encounter_id (chưa xây ở PR này — đó là module `encounter` giai đoạn Khám bệnh sau).
//
// v1 chỉ tạo dòng thẳng ở status=CHECKED_IN qua ReceptionService.checkIn() (đọc appointment đã
// SCHEDULED, tạo encounter, chuyển appointment sang CONVERTED — cùng 1 transaction). Enum vẫn đủ
// 6 giá trị theo state machine đã chốt (packages/core/src/encounter/encounter-state-machine.ts)
// dù SCHEDULED/NO_SHOW hiện chưa có luồng nào ghi tới cho riêng bảng này.
model Encounter {
  id             String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  patientId      String          @map("patient_id") @db.Uuid
  doctorId       String          @map("doctor_id") @db.Uuid
  // Không @unique ở đây — constraint thật là partial unique index raw SQL (WHERE appointment_id
  // IS NOT NULL AND deleted_at IS NULL, xem migration), Prisma không biểu diễn được unique có điều
  // kiện WHERE (cùng lý do patient.nationalIdHash không khai @unique).
  appointmentId  String?         @map("appointment_id") @db.Uuid
  encounterNo    String          @map("encounter_no")
  status         EncounterStatus
  specialty      String          @default("general")
  checkedInAt    DateTime        @map("checked_in_at") @db.Timestamptz(6)
  startedAt      DateTime?       @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime?       @map("completed_at") @db.Timestamptz(6)
  chiefComplaint String?         @map("chief_complaint")
  // Bản chụp thẻ BHYT tại thời điểm check-in — v1 luôn { selfPay: true } (module insurance_card/
  // S2-04 chưa làm, xem docs/DECISIONS.md #032/mới). Đúng tên cột theo docs/ERD.md.
  insuranceSnapshot Json          @map("insurance_snapshot") @db.JsonB
  // "Bỏ về" (CHECKED_IN→CANCELLED, bắt buộc lý do) — không soft-delete, cùng khuôn
  // appointment.cancelReason. Bổ sung ngoài docs/ERD.md gốc, xem migration + docs/DECISIONS.md.
  cancelReason      String?       @map("cancel_reason")
  // "Tiếp nhận bệnh nhân" (tạo encounter trực tiếp, appointmentId=null) — mã danh mục
  // PATIENT_SOURCE đã chọn, tuỳ chọn. Cùng convention patient.ethnicity: lưu code, không lưu tên.
  patientSourceCode String?       @map("patient_source_code")
  // SNAPSHOT loại khám (category EXAM_TYPE) tại thời điểm tạo — copy tên+giá từ reference_catalog
  // lúc chọn trên web, không JOIN lại lúc đọc, cùng tinh thần insuranceSnapshot: đổi giá/tên danh
  // mục sau này không ảnh hồ sơ cũ. NULL khi encounter tạo qua check-in từ lịch hẹn (không có
  // loại khám ở luồng đó).
  examTypeCode      String?       @map("exam_type_code")
  examTypeName      String?       @map("exam_type_name")
  examTypePrice     BigInt?       @map("exam_type_price")
  // Thiết kế lại "Tiếp nhận bệnh nhân" (mockup đã duyệt) — Loại tiếp nhận/Hình thức khám (mã danh
  // mục RECEPTION_TYPE/EXAM_FORM), Ưu tiên khám + lý do (PRIORITY_REASON, bắt buộc kèm khi có ưu
  // tiên — ràng buộc ở packages/shared, không phải DB). Tất cả nullable ở DB (áp dụng dần cho
  // encounter mới, không phá dữ liệu cũ).
  receptionTypeCode String?       @map("reception_type_code")
  examFormCode      String?       @map("exam_form_code")
  isPriority        Boolean       @default(false) @map("is_priority")
  priorityReasonCode String?      @map("priority_reason_code")
  // "Chỉ định dịch vụ khám" — Loại giá dịch vụ (PRICE_TYPE, tuỳ chọn, chỉ ghi chú) + Đơn vị/Số
  // lượng SNAPSHOT tại thời điểm tạo (cùng tinh thần examTypeCode/Name/Price) — chỉ lưu để hiển
  // thị, KHÔNG tính viện phí/xuất hoá đơn (ngoài phạm vi v1, CLAUDE.md).
  priceTypeCode     String?       @map("price_type_code")
  examTypeUnit      String?       @map("exam_type_unit")
  serviceQuantity   Int           @default(1) @map("service_quantity")

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])
  // Composite FK (tenant_id, patient_id/doctor_id/appointment_id) -> ...(tenant_id, id): chống trỏ
  // chéo tenant (C5, docs/ERD.md mục 4), appointment_id nullable nên FK chỉ áp khi có giá trị.
  patient     Patient      @relation(fields: [tenantId, patientId], references: [tenantId, id])
  doctor      UserAccount  @relation("EncounterDoctor", fields: [tenantId, doctorId], references: [tenantId, id])
  appointment Appointment? @relation(fields: [tenantId, appointmentId], references: [tenantId, id])
  vitalSigns  VitalSign[]
  diagnoses     Diagnosis[]
  clinicalNotes ClinicalNote[]

  @@unique([tenantId, id])
  @@unique([tenantId, encounterNo])
  @@map("encounter")
}

// Sinh hiệu (Sprint 3, REC-02/03) — xem docs/ERD.md mục 3.4 (khối VITAL_SIGN), .claude/docs/
// data-model.md. Số nguyên: nhiệt độ theo phần mười độ C (37.5°C → 375), cân nặng theo gram,
// chiều cao theo mm — tránh số thực. Mọi cột đo NULLABLE (cho phép nhập từng phần, không bắt buộc
// đủ mọi chỉ số trong một lần ghi). Không có cột `measured_by` riêng (chỉ có trong mô tả tóm tắt
// lệch của data-model.md, không có trong ERD.md chi tiết — dùng `created_by` sẵn có, xem
// docs/DECISIONS.md).
model VitalSign {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  encounterId       String   @map("encounter_id") @db.Uuid
  pulse             Int?     @db.SmallInt
  temperatureDeciC  Int?     @map("temperature_deci_c") @db.SmallInt
  bpSystolic        Int?     @map("bp_systolic") @db.SmallInt
  bpDiastolic       Int?     @map("bp_diastolic") @db.SmallInt
  respiratoryRate   Int?     @map("respiratory_rate") @db.SmallInt
  spo2              Int?     @db.SmallInt
  weightGram        Int?     @map("weight_gram")
  heightMm          Int?     @map("height_mm")
  measuredAt        DateTime @map("measured_at") @db.Timestamptz(6)

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])
  // Composite FK (tenant_id, encounter_id) -> encounter(tenant_id, id): chống trỏ chéo tenant.
  encounter Encounter @relation(fields: [tenantId, encounterId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@map("vital_sign")
}

// Chẩn đoán (S3-05→07) — docs/ERD.md mục 3.4 (khối DIAGNOSIS). Đúng một PRIMARY/encounter (C10) —
// unique partial index raw SQL trong migration (WHERE type='PRIMARY' AND deleted_at IS NULL),
// không khai @unique ở đây (Prisma không biểu diễn được unique có điều kiện WHERE, cùng lý do
// patient.nationalIdHash/encounter.appointmentId).
model Diagnosis {
  id          String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  encounterId String        @map("encounter_id") @db.Uuid
  // FK thường (không composite) tới icd10_catalog.code — danh mục toàn hệ thống, không có tenant_id.
  icd10Code   String        @map("icd10_code")
  type        DiagnosisType
  note        String?

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  // Composite FK (tenant_id, encounter_id) -> encounter(tenant_id, id): chống trỏ chéo tenant.
  encounter Encounter   @relation(fields: [tenantId, encounterId], references: [tenantId, id])
  icd10     Icd10Catalog @relation(fields: [icd10Code], references: [code])

  @@unique([tenantId, id])
  @@map("diagnosis")
}

// Ghi chú khám (S3-05→07, đổi từ 4 mục SOAP sang 8 mục nhóm Tiền sử/Thăm khám — xem enum
// ClinicalNoteSection) — docs/ERD.md mục 3.4 (khối CLINICAL_NOTE), .claude/docs/
// clinical-workflow.md mục "Amendment hồ sơ". MỘT DÒNG/section/encounter (unique partial WHERE
// deleted_at IS NULL trong migration — cơ sở cho upsert tìm-hoặc-tạo). `signedAt`/`signedBy`/
// `supersedesId`/`amendmentReason` để sẵn theo `SignableEntity` (packages/core) — LUÔN NULL ở vòng
// này, ký hồ sơ (ENC-04) và luồng đính chính là việc của Sprint 5 (S5-02/03), chưa viết logic.
model ClinicalNote {
  id              String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  encounterId     String              @map("encounter_id") @db.Uuid
  section         ClinicalNoteSection
  content         String
  signedAt        DateTime?           @map("signed_at") @db.Timestamptz(6)
  signedBy        String?             @map("signed_by") @db.Uuid
  supersedesId    String?             @map("supersedes_id") @db.Uuid
  amendmentReason String?             @map("amendment_reason")

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  // Composite FK (tenant_id, encounter_id) -> encounter(tenant_id, id): chống trỏ chéo tenant.
  encounter Encounter @relation(fields: [tenantId, encounterId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@map("clinical_note")
}

// Append-only — không updated_at, không deleted_at, không version (ngoại lệ đã ghi trong data-model.md).
model AuditLog {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  beforeJson Json?    @map("before_json") @db.JsonB
  afterJson  Json?    @map("after_json") @db.JsonB
  ip         String?
  userAgent  String?  @map("user_agent")
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("audit_log")
}
