// Schema nền tảng — Sprint 1 (xem docs/ERD.md mục 6 "Thứ tự tạo bảng theo sprint").
// Chỉ chứa nhóm bảng "Nền tảng và tenant": tenant, tenant_setting, room, department,
// user_account, role, permission, role_permission, user_role, code_sequence,
// break_glass_session, audit_log, user_session (S1-04, xem docs/DECISIONS.md #019).
// Các bảng patient/appointment/encounter... thuộc Sprint 2-3, chưa thêm ở đây.
//
// RBAC + Data Scope (thay mô hình vai trò cứng) — xem .claude/docs/security-audit.md
// và docs/DECISIONS.md #013-#016.
//
// Quy ước bắt buộc — xem .claude/docs/data-model.md:
// - Mọi bảng nghiệp vụ có đủ 8 cột: id, tenant_id, created_at, updated_at,
//   deleted_at, version, created_by, updated_by.
// - Ngoại lệ: `tenant` không có tenant_id (chính nó là gốc của tenant),
//   `audit_log` không có updated_at/deleted_at/version (append-only).
// - `created_by`/`updated_by` là UUID ghi nhận actor, KHÔNG khai báo @relation
//   (xem docs/DECISIONS.md #005) — tránh vòng phụ thuộc lúc khởi tạo tenant đầu tiên.
// - id dùng uuidv7() (PostgreSQL 18 trở lên, có sẵn trong core) — khớp đúng
//   "UUID v7, sinh phía DB" trong data-model.md. Xem docs/DECISIONS.md #009.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String
  taxCode   String? @map("tax_code")
  address   String?
  licenseNo String? @map("license_no")
  isActive  Boolean @default(true) @map("is_active")

  // Cấu hình "Thông tin phòng khám" (2026-08-13) — phone/email tự do; currency/timezone luôn có
  // giá trị hiển thị (default) nhưng CHƯA nối vào logic tính toán/ngày giờ hệ thống, chỉ lưu
  // trước; logoKey/printLogoKey khoá lưu trên StoragePort, cùng mẫu patient.photoKey.
  phone        String?
  email        String?
  currency     String  @default("VND")
  timezone     String  @default("Asia/Ho_Chi_Minh")
  logoKey      String? @map("logo_key")
  printLogoKey String? @map("print_logo_key")

  // 8 cột bắt buộc (trừ tenant_id — bảng này là gốc của tenant)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenantSettings         TenantSetting[]
  floors                 Floor[]
  rooms                  Room[]
  examStations           ExamStation[]
  workShifts             WorkShift[]
  workShiftAssignments   WorkShiftAssignment[]
  departmentTypes        DepartmentType[]
  departments            Department[]
  userAccounts           UserAccount[]
  roles                  Role[]
  rolePermissions        RolePermission[]
  codeSequences          CodeSequence[]
  auditLogs              AuditLog[]
  breakGlassSessions     BreakGlassSession[]
  doctorRoomSessions     DoctorRoomSession[]
  doctorAvailabilities   DoctorAvailability[]
  userSessions           UserSession[]
  patients               Patient[]
  appointments           Appointment[]
  encounters             Encounter[]
  vitalSigns             VitalSign[]
  encounterServiceItems  EncounterServiceItem[]
  diagnoses              Diagnosis[]
  clinicalNotes          ClinicalNote[]
  drugs                  Drug[]
  prescriptions          Prescription[]
  prescriptionItems      PrescriptionItem[]
  patientAllergens       PatientAllergen[]
  patientConditions      PatientCondition[]
  patientFamilyHistories PatientFamilyHistory[]
  examTypePrices         ExamTypePrice[]
  invoices               Invoice[]
  invoiceLines           InvoiceLine[]
  payments               Payment[]
  cashierShifts          CashierShift[]
  cashAccounts           CashAccount[]
  cashVouchers           CashVoucher[]

  @@map("tenant")
}

model TenantSetting {
  id        String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  key       String
  valueJson Json   @map("value_json") @db.JsonB

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@map("tenant_setting")
}

// "Tầng" (docs/DECISIONS.md #055) — thuần phân loại/tổ chức không gian, TÙY CHỌN (`room.floorId`
// nullable). Phòng khám 1 tầng không tạo dòng nào ở đây, web tự ẩn mọi UI liên quan (cùng nguyên
// tắc "tự ẩn khi ≤1" đã áp dụng cho `room` ở #054) — không có cột "mặc định", suy ra từ số dòng.
model Floor {
  id        String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  name      String
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])
  rooms  Room[]

  // Đích của composite FK (tenant_id, id) từ room.
  @@unique([tenantId, id])
  @@map("floor")
}

model Room {
  id       String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  floorId  String? @map("floor_id") @db.Uuid
  name     String
  isActive Boolean @default(true) @map("is_active")

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant               Tenant              @relation(fields: [tenantId], references: [id])
  // floor_id nullable — FK chỉ áp khi có giá trị (Postgres MATCH SIMPLE, cùng mẫu
  // user_account.department ở trên).
  floor                Floor?              @relation(fields: [tenantId, floorId], references: [tenantId, id])
  appointments         Appointment[]
  doctorRoomSessions   DoctorRoomSession[]
  examStations         ExamStation[]
  // Đích ngược của user_account.default_room_id (redesign 3-tab #082) — "Phòng khám mặc định".
  usersWithDefaultRoom UserAccount[]

  // Đích của composite FK (tenant_id, id) từ appointment (S2-05), doctor_room_session, exam_station,
  // user_account.default_room_id.
  @@unique([tenantId, id])
  @@map("room")
}

// "Bàn khám / Ghế" (docs/DECISIONS.md #055) — cấp con của `room`, THUẦN MÔ TẢ/tổ chức (ví dụ
// phòng khám nha nhiều ghế trong 1 phòng). KHÔNG phải đơn vị điều phối — "phòng làm việc hôm nay"
// của bác sĩ (`doctor_room_session`) và `appointment.room_id` vẫn dừng ở cấp `room`, không xuống
// tới đây (đã hỏi và chốt qua AskUserQuestion trước khi thiết kế).
model ExamStation {
  id        String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  roomId    String  @map("room_id") @db.Uuid
  name      String
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])
  room   Room   @relation(fields: [tenantId, roomId], references: [tenantId, id])

  @@map("exam_station")
}

// "Ca làm việc" — danh mục mẫu ca (giờ/màu/giờ nghỉ/số giờ công chuẩn) do clinic_admin tự quản lý
// RIÊNG cho từng phòng khám (tenant-scoped) — KHÔNG dùng chung khuôn `reference_catalog` (toàn hệ
// thống, không tenant_id) vì mỗi phòng khám tự đặt giờ ca riêng, không phải danh mục chia sẻ nhiều
// tenant như EXAM_TYPE/ICD-10. Cùng khuôn `room`/`department` — thao tác qua bác sĩ đăng ký ca
// theo tuần/tháng (giai đoạn kế tiếp, chưa xây) sẽ tham chiếu tới bảng này.
model WorkShift {
  id                  String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId            String  @map("tenant_id") @db.Uuid
  name                String
  // Mã ngắn tự sinh (packages/core/src/reference-catalog/generate-code.ts), không nhập tay —
  // clinic_admin chỉ đặt tên "Ca sáng"/"Ca chiều", không tự nghĩ mã.
  code                String
  // "HH:mm" — so sánh chuỗi đủ dùng, không cần kiểu `time` của Postgres (cùng khuôn
  // `tenant_setting.business_hours`/`DayHours.open-close`).
  startTime           String  @map("start_time")
  endTime             String  @map("end_time")
  // Enum cố định 8 giá trị ở tầng ứng dụng (packages/shared/src/work-shift.ts) — TEXT ở DB để
  // không phải thêm Postgres enum riêng cho một danh sách màu thuần hiển thị.
  color               String
  // Giờ nghỉ giữa ca — hoàn toàn tuỳ chọn, độc lập với `restMinutes` (không bắt buộc khớp nhau,
  // xem docs/DECISIONS.md).
  restStartTime       String? @map("rest_start_time")
  restEndTime         String? @map("rest_end_time")
  // Phút — cả "Tổng thời gian nghỉ" lẫn "Số giờ công chuẩn" đều quy đổi về phút lúc lưu (nhất
  // quán với `durationMinutes`/`GRID_STEP_MINUTES` đã dùng trong hệ thống), UI tự quy đổi lại
  // đúng đơn vị người dùng đã chọn lúc nhập (giờ/phút).
  restMinutes         Int?    @map("rest_minutes")
  standardWorkMinutes Int?    @map("standard_work_minutes")
  sortOrder           Int     @default(0) @map("sort_order")
  isActive            Boolean @default(true) @map("is_active")

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant      Tenant                @relation(fields: [tenantId], references: [id])
  assignments WorkShiftAssignment[]

  @@unique([tenantId, code])
  // Đích cho composite FK từ `work_shift_assignment` (Giai đoạn 2, đăng ký ca theo ngày) — thêm
  // SAU migration #101 gốc (Prisma không tự sinh unique này lúc chỉ có `@@unique([tenantId, code])`),
  // đúng bài học đã gặp với `room`/`department_type` ("lần đầu bị composite FK tham chiếu tới").
  @@unique([tenantId, id])
  @@map("work_shift")
}

// "Đăng ký ca làm việc" (Giai đoạn 2 của #101) — MỌI nhân viên (không riêng bác sĩ) tự đăng ký ca
// đã có trong danh mục `work_shift` cho một NGÀY CỤ THỂ (`workDate`, nullable-free — nhận từ
// client, khác `doctor_availability`/`doctor_room_session` luôn ép "hôm nay"). Nhiều dòng/ngày
// được (ví dụ Sáng+Chiều), miễn không trùng đúng 1 ca 2 lần cùng ngày (unique dưới). Tự sửa/xoá
// tự do TRONG ĐÚNG NGÀY LỊCH VN đã tạo (`createdAt`, kiểm ở Service — PermissionGuard không có
// khái niệm điều kiện thời gian), khoá lại từ hôm sau — chỉ vai trò có quyền `update`/`delete`
// scope `global` (mặc định clinic_admin) sửa/xoá được sau đó.
model WorkShiftAssignment {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  workShiftId String   @map("work_shift_id") @db.Uuid
  workDate    DateTime @map("work_date") @db.Date

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  user      UserAccount @relation(fields: [tenantId, userId], references: [tenantId, id])
  workShift WorkShift   @relation(fields: [tenantId, workShiftId], references: [tenantId, id])

  @@map("work_shift_assignment")
}

// "Phòng làm việc hôm nay" của bác sĩ — thuần vận hành/định tuyến UI (KHÔNG phải dữ liệu lâm
// sàng, không dùng để lọc data_scope của encounter/hàng đợi khám, xem docs/DECISIONS.md).
// 1 dòng/bác sĩ/ngày lịch Việt Nam (workDate) — partial unique viết ở migration (cùng lý do
// user_role/patient.national_id_hash không khai `@@unique` được trong Prisma: điều kiện WHERE).
model DoctorRoomSession {
  id       String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  doctorId String   @map("doctor_id") @db.Uuid
  roomId   String   @map("room_id") @db.Uuid
  workDate DateTime @map("work_date") @db.Date

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  doctor UserAccount @relation(fields: [tenantId, doctorId], references: [tenantId, id])
  room   Room        @relation(fields: [tenantId, roomId], references: [tenantId, id])

  @@map("doctor_room_session")
}

enum DoctorAvailabilityStatus {
  ACTIVE
  BREAK
  ENDED
}

// "Tạm nghỉ / Đóng ca" của bác sĩ — trạng thái sẵn sàng nhận bệnh, TÁCH BIỆT khỏi `encounter.status`
// và khỏi `doctor_room_session` (bảng đó THUẦN chọn phòng ngồi vật lý, không phải khoá điều phối —
// giữ nguyên ý nghĩa đã chốt). Chỉ tác động routing: bác sĩ BREAK/ENDED không được điều phối ca mới
// (theo bác sĩ cụ thể lẫn theo Khoa qua pool). 1 dòng/bác sĩ/ngày lịch Việt Nam (workDate), cùng
// khuôn `doctor_room_session` — không có dòng cho hôm nay = ACTIVE ngầm định.
model DoctorAvailability {
  id              String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String                   @map("tenant_id") @db.Uuid
  doctorId        String                   @map("doctor_id") @db.Uuid
  workDate        DateTime                 @map("work_date") @db.Date
  status          DoctorAvailabilityStatus
  statusChangedAt DateTime                 @map("status_changed_at") @db.Timestamptz(6)
  reason          String?

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  doctor UserAccount @relation(fields: [tenantId, doctorId], references: [tenantId, id])

  @@map("doctor_availability")
}

// Khoa/phòng trong 1 tenant — phục vụ Data Scope `department` (security-audit.md).
// v1 phần lớn phòng khám không dùng (1-3 bác sĩ, không chia khoa) nhưng bảng luôn tồn tại.
// "Loại Khoa/Phòng" (mở rộng ADM-01, yêu cầu chủ dự án 2026-08-20) — cấp cha TÙY CHỌN của
// `department`, THUẦN phân loại/tổ chức, đúng khuôn `Floor` (cấp cha tùy chọn của `Room`).
model DepartmentType {
  id       String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  name     String
  isActive Boolean @default(true) @map("is_active")

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  departments Department[]

  // Đích của composite FK (tenant_id, id) từ department.
  @@unique([tenantId, id])
  @@map("department_type")
}

model Department {
  id                  String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId            String  @map("tenant_id") @db.Uuid
  departmentTypeId    String? @map("department_type_id") @db.Uuid
  // Mã hiển thị tự sinh qua CodeSequenceRepository (prefix "KP"), đúng khuôn patient_code/
  // employee_code — KHÔNG nhập tay. Nullable: phòng ban tạo trước tính năng này không backfill.
  code                String?
  name                String
  // Mở rộng ADM-01 (2026-08-20) — danh mục Khoa/Phòng quản lý được qua UI (Thêm/Sửa/Ẩn), cùng
  // khuôn Room (isActive, không phải soft-delete deletedAt — giữ nguyên lịch sử gán trên
  // user_account.department_id, chỉ ẩn khỏi Combobox chọn mới).
  isActive            Boolean @default(true) @map("is_active")
  // "Hàng đợi ảo" (#064) — đánh dấu "Khoa chung" tự sinh mỗi tenant lúc seed
  // (`seedDefaultRolesForTenant`), dùng làm fallback `encounter.department_id` khi bác sĩ chưa gán
  // Khoa hoặc lúc Tiếp nhận chọn thẳng "Khoa chung". Đúng 1 dòng/tenant — ép bằng partial unique
  // index raw SQL trong migration (`(tenant_id) WHERE is_default`), không khai `@@unique` ở Prisma
  // (không biểu diễn được unique có điều kiện, cùng lý do patient.nationalIdHash).
  isDefault           Boolean @default(false) @map("is_default")
  // Khoa/Phòng này có xuất hiện trong khu vực điều phối "Hàng đợi khám" không (GET
  // /departments/options, #064) — TÁCH KHỎI department_type (thuần mô tả/tổ chức, #063) vì dựa
  // vào tên/loại để suy luận "khoa nào là lâm sàng" sẽ vỡ ngầm khi đổi tên Loại. Mặc định true.
  participatesInQueue Boolean @default(true) @map("participates_in_queue")

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  // department_type_id nullable — FK chỉ áp khi có giá trị (Postgres MATCH SIMPLE, cùng mẫu room.floor).
  departmentType DepartmentType? @relation(fields: [tenantId, departmentTypeId], references: [tenantId, id])
  userAccounts   UserAccount[]
  // "Hàng đợi ảo" (#064) — mọi encounter thuộc một Khoa cụ thể (bắt buộc), dù đã gán bác sĩ hay
  // còn trong hàng chờ chung.
  encounters     Encounter[]

  // Đích của composite FK (tenant_id, id) từ user_account/encounter.
  @@unique([tenantId, id])
  @@map("department")
}

model UserAccount {
  id            String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  departmentId  String? @map("department_id") @db.Uuid
  defaultRoomId String? @map("default_room_id") @db.Uuid
  username      String
  passwordHash  String  @map("password_hash")
  fullName      String  @map("full_name")
  // Tên hiển thị (redesign 3-tab, 2026-08-27, docs/DECISIONS.md #082) — dùng khi in đơn thuốc/HSBA
  // và mọi nơi hiển thị tên tài khoản. Nullable ở DB (tài khoản cũ trước tính năng này để trống,
  // không backfill), NHƯNG bắt buộc ở `createUserAccountRequestSchema` cho tài khoản tạo mới.
  displayName   String? @map("display_name")
  licenseNo     String? @map("license_no")
  isActive      Boolean @default(true) @map("is_active")

  // Hồ sơ nhân sự (mở rộng ADM-01) — tất cả nullable, tài khoản cũ trước tính năng này để trống,
  // không backfill (chưa có tenant production). employeeCode sinh tự động qua code_sequence
  // (prefix "NV") CHỈ cho tài khoản tạo mới, không unique cứng ở DB (tài khoản cũ đều NULL, có
  // thể trùng NULL — Postgres không tính NULL trùng NULL trong UNIQUE thường).
  employeeCode         String?   @map("employee_code")
  phone                String?
  // Gộp personal_email/company_email cũ thành 1 cột (redesign 3-tab, #082) — đảo ngược thiết kế
  // ADM-01 ban đầu, chốt qua AskUserQuestion (không backfill company_email cũ, chưa có tenant
  // production).
  email                String?   @map("email")
  dob                  DateTime? @map("dob") @db.Date
  gender               String?   @map("gender")
  licenseIssuedAt      DateTime? @map("license_issued_at") @db.Date
  licenseIssuedPlace   String?   @map("license_issued_place")
  // Ảnh chữ ký (PNG, redesign 3-tab #082) — khoá lưu trên StoragePort, cùng mẫu patient.photoKey/
  // clinic.logoKey. Chỉ upload được SAU khi tài khoản đã tồn tại (endpoint riêng, cần `id` để đặt
  // tên key) — đúng ràng buộc đã áp dụng cho patient.photoKey.
  signatureKey         String?   @map("signature_key")
  // 4 cột dưới lưu `code` của reference_catalog (category tương ứng) — không FK cứng, cùng khuôn
  // patient.ethnicity/occupation (xem comment model ReferenceCatalog).
  academicTitleCode    String?   @map("academic_title_code")
  positionCode         String?   @map("position_code")
  employmentStatusCode String?   @map("employment_status_code")
  employmentTypeCode   String?   @map("employment_type_code")
  // Được ký HSBA — CHỈ lưu metadata ở v1, chưa gắn logic chặn nào (chữ ký số/chữ ký logic thật là
  // Sprint 5, ENC-04 — đúng tinh thần CLAUDE.md "chữ ký số chưa triển khai ở v1").
  canSignMedicalRecord Boolean   @default(false) @map("can_sign_medical_record")
  // Bắt tài khoản đổi mật khẩu ở lần đăng nhập kế tiếp — enforce thật qua `POST /auth/change-
  // password` + chặn điều hướng ở web (`RequireAuth`), xem auth.service.ts.
  mustChangePassword   Boolean   @default(false) @map("must_change_password")

  // Khoá tài khoản tạm sau 5 lần đăng nhập sai trong 15 phút — xem
  // .claude/docs/security-audit.md mục Xác thực, packages/core/src/iam/lockout.ts.
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lastFailedLoginAt DateTime? @map("last_failed_login_at") @db.Timestamptz(6)
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(6)

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant                 Tenant                @relation(fields: [tenantId], references: [id])
  // Composite FK (tenant_id, department_id) -> department(tenant_id, id): department_id
  // nullable nên FK chỉ áp khi có giá trị (Postgres MATCH SIMPLE — xem docs/DECISIONS.md).
  department             Department?           @relation(fields: [tenantId, departmentId], references: [tenantId, id])
  // "Phòng khám mặc định" (redesign 3-tab #082) — cùng mẫu department ở trên, FK chỉ áp khi có
  // giá trị. Chỉ là gợi ý mặc định hiển thị, KHÔNG đổi cơ chế "Phòng làm việc hôm nay"
  // (doctor_room_session, #054) — hai khái niệm tách biệt.
  defaultRoom            Room?                 @relation(fields: [tenantId, defaultRoomId], references: [tenantId, id])
  userRoles              UserRole[]
  sessions               UserSession[]
  appointmentsAsDoctor   Appointment[]         @relation("AppointmentDoctor")
  encountersAsDoctor     Encounter[]           @relation("EncounterDoctor")
  roomSessionsAsDoctor   DoctorRoomSession[]
  availabilityAsDoctor   DoctorAvailability[]
  workShiftAssignments   WorkShiftAssignment[]
  cashierShiftsAsCashier CashierShift[]

  // Đích của composite FK (tenant_id, id) từ user_role — chống trỏ chéo tenant (C5 trong ERD.md).
  @@unique([tenantId, id])
  @@unique([tenantId, username])
  @@map("user_account")
}

// Phiên refresh token — cho phép "xoay vòng mỗi lần refresh" (rotation) + phát hiện token bị
// đánh cắp (reuse detection): mỗi lần refresh, phiên cũ bị soft-delete (deleted_reason =
// 'rotated') và trỏ replacedBySessionId sang phiên mới. Nếu một hash đã bị rotate còn bị dùng
// lại, đó là dấu hiệu token rò rỉ — service thu hồi toàn bộ phiên của user (deleted_reason =
// 'reuse_detected'). Thu hồi = soft delete, dùng đúng pattern deleted_at/deleted_reason sẵn có
// trong hệ thống, không cần cột "revoked" riêng. Xem .claude/docs/security-audit.md mục Xác
// thực, docs/DECISIONS.md #019.
model UserSession {
  id                  String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  refreshTokenHash    String   @unique @map("refresh_token_hash")
  issuedAt            DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt           DateTime @map("expires_at") @db.Timestamptz(6)
  // Composite FK (tenant_id, replaced_by_session_id) -> user_session(tenant_id, id): phiên kế
  // tiếp trong chuỗi rotation, null nếu đây vẫn là phiên hiện hành hoặc đã bị thu hồi thẳng
  // (logout/reuse_detected/role_changed) chứ không phải rotate.
  replacedBySessionId String?  @map("replaced_by_session_id") @db.Uuid
  ip                  String?  @db.Text
  userAgent           String?  @map("user_agent") @db.Text

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  // Composite FK (tenant_id, user_id) -> user_account(tenant_id, id): chống trỏ chéo tenant.
  user       UserAccount   @relation(fields: [tenantId, userId], references: [tenantId, id])
  replacedBy UserSession?  @relation("SessionRotation", fields: [tenantId, replacedBySessionId], references: [tenantId, id])
  previousOf UserSession[] @relation("SessionRotation")

  @@unique([tenantId, id])
  @@map("user_session")
}

// Vai trò theo tenant (không còn enum cứng) — clinic_admin tạo thêm được vai trò tuỳ biến.
// Seed 5 vai trò mặc định (is_system_default = true) lúc tạo tenant — xem prisma/seed/.
model Role {
  id              String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String  @map("tenant_id") @db.Uuid
  name            String
  isSystemDefault Boolean @default(false) @map("is_system_default")

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  // Đích của composite FK (tenant_id, id) từ user_role/role_permission.
  @@unique([tenantId, id])
  // UNIQUE(tenant_id, name) đổi từ thường sang PARTIAL (WHERE deleted_at IS NULL) ở ADM-07 (tạo
  // vai trò tuỳ biến, migration `20260820090000_role_management`) — unique thường (khai báo cũ
  // `@@unique([tenantId, name])`, từ migration `20260808015619_rbac_data_scope`) sẽ chặn tạo lại
  // đúng tên vai trò đã từng bị ẩn (soft-delete) trước đó. Không khai báo được `@@unique` có
  // `WHERE` bằng Prisma schema (giống C3 `patient.national_id_hash`, `user_role`) — viết raw SQL
  // trong migration, không khai báo ở đây.
  @@map("role")
}

// Danh mục hành động — TOÀN HỆ THỐNG (giống icd10_catalog), không có tenant_id, seed cố
// định theo code, không do phòng khám tự định nghĩa. Định dạng "<module>.<action>".
model Permission {
  id          String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  module      String
  action      String
  description String

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permission")
}

enum ReferenceCatalogCategory {
  ETHNICITY
  NATIONALITY
  // Sprint 3, phần Tiếp nhận — Nguồn khách hàng / Loại khám, quản lý ở Cấu hình, tái dùng nguyên
  // bảng này thay vì tạo bảng riêng (docs/DECISIONS.md).
  PATIENT_SOURCE
  EXAM_TYPE
  // Thiết kế lại "Tiếp nhận bệnh nhân" (mockup đã duyệt) — Loại tiếp nhận / Hình thức khám / Lý do
  // ưu tiên / Loại giá dịch vụ, cùng lý do tái dùng bảng này (docs/DECISIONS.md).
  RECEPTION_TYPE
  EXAM_FORM
  PRIORITY_REASON
  PRICE_TYPE
  // Nghề nghiệp — đảo ngược tiếp phần `occupation` của docs/DECISIONS.md #034 (trước đây cố ý để
  // text tự do, không danh mục hoá). Ban đầu (#061) không seed cứng vì thiếu nguồn dữ liệu chính
  // thức; 2026-09-05 chủ dự án gửi `docs/data/nghe-nghiep.md` (13 mã, packages/core/src/
  // reference-catalog/data.ts OCCUPATION_ITEMS) — seed sẵn, vẫn quản lý thêm/sửa/ẩn được qua UI.
  OCCUPATION
  // Danh mục quản lý tài khoản nhân sự (mở rộng ADM-01) — Học vị/học hàm và Chức danh không có
  // nguồn dữ liệu chính thức, không seed cứng. Trạng thái làm việc và Hình thức làm việc CÓ seed
  // 3/4 giá trị mặc định (packages/core/src/reference-catalog/data.ts) vì chủ dự án đã cho sẵn
  // giá trị chuẩn, nhưng vẫn quản lý được qua UI (clinic_admin thêm được trạng thái/hình thức
  // khác nếu cần).
  ACADEMIC_TITLE
  STAFF_POSITION
  EMPLOYMENT_STATUS
  EMPLOYMENT_TYPE
  // Đơn vị tính (ví dụ "Viên", "Lọ", "Chai") — chủ dự án yêu cầu trực tiếp 2026-08-26. Không có
  // nguồn dữ liệu chính thức để giữ mã cố định (khác OCCUPATION) — seed sẵn 47 đơn vị mặc định
  // (2026-09-05, packages/core/src/reference-catalog/unit-seed-data.ts) nhưng mã tự sinh ngắn
  // tuần tự (#113, tiền tố "DV") thay vì mã cho trước, vẫn quản lý qua UI.
  UNIT
  // Hình thức thanh toán (Thu ngân, chủ dự án yêu cầu trực tiếp 2026-08-27) — thay Postgres enum
  // `payment_method` cố định (CASH/BANK_TRANSFER) trước đây trên Payment.method/
  // Invoice.pendingPaymentMethod. Seed đúng 2 code cũ (migration kế tiếp, sau khi giá trị enum
  // này commit) để dữ liệu hiện có resolve đúng tên, quản lý thêm/sửa/ẩn qua UI như UNIT.
  PAYMENT_METHOD
  // Loại thu chi (chủ dự án yêu cầu trực tiếp 2026-09-05) — chuẩn bị cho chức năng "Thu chi tại
  // quầy"/Sổ quỹ sắp làm (CHƯA xây ở migration này, chỉ danh mục). Không seed cứng, mã tự sinh như
  // UNIT/PAYMENT_METHOD. Có thêm cột `direction` riêng (xem enum ReferenceCatalogDirection).
  INCOME_EXPENSE_TYPE

  @@map("reference_catalog_category")
}

// "Loại" của một mục INCOME_EXPENSE_TYPE — CHỈ 2 giá trị cố định (Chi tiền/Thu tiền), không quản
// lý/mở rộng qua UI (khác code/name của chính category này).
enum ReferenceCatalogDirection {
  EXPENSE
  INCOME

  @@map("reference_catalog_direction")
}

// Danh mục dùng chung — TOÀN HỆ THỐNG (cùng bản chất permission/icd10_catalog), không có
// tenant_id, không đủ 8 cột bắt buộc, không version (rủi ro ghi đè đồng thời thấp — clinic_admin
// sửa không thường xuyên). Quản lý được qua API (create/update/deactivate) bởi clinic_admin
// (reference_catalog.manage), khác `permission` — vì vậy GRANT mặc định của nexamed_app (SELECT/
// INSERT/UPDATE, đã cấp qua ALTER DEFAULT PRIVILEGES) được giữ nguyên, không REVOKE gì thêm.
// DELETE đã bị revoke toàn cục cho nexamed_app (migration *_tenant_context) — "xoá" thật ra là
// isActive=false (soft), không phải SQL DELETE. `code` là mã chính thức (dân tộc: "1".."54" theo
// Tổng cục Thống kê; quốc tịch: ISO 3166-1 alpha-3) — đây là giá trị lưu trên
// patient.ethnicity/patient.nationality/patient.occupation (docs/DECISIONS.md, đảo ngược #034
// phần ethnicity/nationality; occupation đảo ngược tiếp sau đó — xem entry OCCUPATION).
model ReferenceCatalog {
  id                 String                     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  category           ReferenceCatalogCategory
  code               String
  name               String
  sortOrder          Int                        @default(0) @map("sort_order")
  isActive           Boolean                    @default(true) @map("is_active")
  // Giá tham khảo (đồng) — CHỈ có ý nghĩa với category EXAM_TYPE, NULL với category khác. v1 chỉ
  // lưu để hiển thị, không tính toán/xuất hoá đơn (viện phí ngoài phạm vi CLAUDE.md).
  price              BigInt?
  // Đơn vị (ví dụ "Lượt", "Buổi") — cùng bản chất `price`, chỉ có ý nghĩa với category EXAM_TYPE.
  unit               String?
  // Tự động vô hiệu hoá tài khoản khi được chọn làm Trạng thái làm việc của một nhân viên — CHỈ
  // có ý nghĩa với category EMPLOYMENT_STATUS (giống price/unit chỉ có ý nghĩa với EXAM_TYPE).
  // Tách thành cột riêng thay vì so khớp `code` cố định ("NGHI_VIEC"...) vì `code` sửa được qua
  // UI (ReferenceCatalogPane) — so khớp chuỗi sẽ hỏng ngầm khi admin đổi mã.
  deactivatesAccount Boolean                    @default(false) @map("deactivates_account")
  // Mô tả tự do — CHỈ có ý nghĩa với category UNIT (Đơn vị tính, chủ dự án yêu cầu trực tiếp
  // 2026-08-26), NULL với category khác (cùng bản chất price/unit/deactivatesAccount ở trên).
  description        String?
  // "Chốt ca" (2026-09-03) — CHỈ có ý nghĩa với category PAYMENT_METHOD: đánh dấu hình thức thanh
  // toán nào gộp vào đối soát đếm két tiền mặt. Tách thành cột riêng thay vì so khớp cứng
  // code='CASH' — cùng lý do deactivatesAccount ở trên (`code` sửa được qua UI).
  countsAsCash       Boolean                    @default(false) @map("counts_as_cash")
  // "Loại thu chi" (2026-09-05) — CHỈ có ý nghĩa với category INCOME_EXPENSE_TYPE: Chi tiền/Thu
  // tiền. `null` với category khác, cùng bản chất price/unit/description ở trên.
  direction          ReferenceCatalogDirection?

  @@unique([category, code])
  @@map("reference_catalog")
}

// "Đơn giá dịch vụ" (docs/DECISIONS.md #079, chủ dự án yêu cầu trực tiếp 2026-08-26) — bảng giá
// đa mức THEO TENANT cho một mục `reference_catalog` category EXAM_TYPE: 1 dịch vụ khám có thể có
// NHIỀU dòng đơn giá (khác Loại giá dịch vụ và/hoặc khác khoảng ngày hiệu lực). Mở rộng phạm vi v1
// đã chốt — CLAUDE.md trước đây loại "bảng giá đa đối tượng" khỏi v1 dưới dạng viện phí đầy đủ
// (đa đối tượng/công nợ/trả góp); đây là dạng ĐƠN GIẢN HƠN nhiều (không nợ/không trả góp, chỉ đa
// mức theo loại giá + hiệu lực theo ngày) nên chốt đưa riêng phần này vào v1.
//
// TÁCH theo tenant (khác `reference_catalog` cha — toàn hệ thống, không tenant_id) vì giá dịch vụ
// khám khác nhau thật giữa các phòng khám dù cùng tên dịch vụ — đủ 8 cột bắt buộc + RLS như mọi
// bảng nghiệp vụ khác. `examTypeCode`/`priceTypeCode`/`unitCode` lưu THẲNG mã (text, KHÔNG FK
// composite thật) — đúng cách mọi cột tham chiếu `reference_catalog` khác đã làm (`patient.
// ethnicity`, `encounter.exam_type_code`...) vì `reference_catalog` là 1 bảng dùng chung nhiều
// category, FK thật không biểu diễn được "chỉ trỏ đúng 1 category". Sửa/xoá tự do (không phải
// SignableEntity, không giữ lịch sử — chốt qua AskUserQuestion 2026-08-26); "xoá" vẫn là soft
// (is_active không có ở đây — dùng deleted_at, role DB không có quyền DELETE cứng).
model ExamTypePrice {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  examTypeCode  String    @map("exam_type_code")
  priceTypeCode String    @map("price_type_code")
  unitCode      String    @map("unit_code")
  amount        BigInt
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, id])
  @@map("exam_type_price")
}

// Danh mục "Dị nguyên" (Allergens, docs/DECISIONS.md #069) — TOÀN HỆ THỐNG, cùng bản chất
// `reference_catalog` (không tenant_id, không đủ 8 cột bắt buộc, không version, quản lý qua API
// bởi clinic_admin, "xoá" = is_active=false). Khác `reference_catalog` ở chỗ có 2 CẤP thật
// (nhóm → dị nguyên) thay vì phẳng theo category — 2 bảng riêng thay vì nhét thêm category mới
// vào `reference_catalog` vì quan hệ cha-con cần FK thật, không biểu diễn được bằng enum category.
// `code` của CẢ HAI bảng đều tự sinh — mã ngắn tuần tự (docs/DECISIONS.md #113,
// packages/core/src/allergen/code-prefixes.ts + GlobalCodeSequenceRepository) — KHÔNG nhận từ
// client (khác `reference_catalog` vẫn cho phép client tự nhập code). `AllergenGroup.code` tồn
// tại trong DB nhưng KHÔNG hiển thị ở
// UI cột trái (chỉ dùng nội bộ, để đồng nhất với Allergen) — cột phải mới hiện "Mã".
model AllergenGroup {
  id        String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code      String     @unique
  name      String
  isActive  Boolean    @default(true) @map("is_active")
  allergens Allergen[]

  @@map("allergen_group")
}

// `allergenGroupId` BẮT BUỘC (không nullable) — khác `department.departmentTypeId` (tuỳ chọn):
// mỗi Dị nguyên luôn thuộc đúng 1 Nhóm dị nguyên, không có trạng thái "chưa phân loại".
model Allergen {
  id               String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  allergenGroupId  String            @map("allergen_group_id") @db.Uuid
  code             String            @unique
  name             String
  isActive         Boolean           @default(true) @map("is_active")
  allergenGroup    AllergenGroup     @relation(fields: [allergenGroupId], references: [id])
  // Bệnh nhân đã gán dị nguyên này (Sprint 4, chốt 2026-08-25) — xem model PatientAllergen.
  patientAllergens PatientAllergen[]

  @@map("allergen")
}

// Danh mục hành chính Tỉnh/Phường-Xã — TOÀN HỆ THỐNG (cùng bản chất icd10_catalog/permission),
// không tenant_id, không đủ 8 cột bắt buộc, không version/is_active. Read-only lúc chạy (khác
// reference_catalog — không có endpoint create/update/delete): dữ liệu hành chính chính thức Bộ
// Nội vụ, không ai cần sửa qua UI. `code` phường/xã 8 chữ số duy nhất toàn quốc (không chỉ trong
// phạm vi tỉnh — đã xác nhận không trùng khi soạn seed), nên PK thẳng bằng `code`, không cần FK
// hỗn hợp province_code trong PK. Xem docs/DECISIONS.md #038.
model Province {
  code      String @id
  name      String
  sortOrder Int    @default(0) @map("sort_order")

  wards Ward[]

  @@map("province")
}

model Ward {
  code         String @id
  name         String
  provinceCode String @map("province_code")
  sortOrder    Int    @default(0) @map("sort_order")

  province Province @relation(fields: [provinceCode], references: [code])

  @@index([provinceCode])
  @@map("ward")
}

enum Icd10GenderRestriction {
  male
  female

  @@map("icd10_gender_restriction")
}

enum Icd10UsageRestriction {
  limited_primary
  not_primary

  @@map("icd10_usage_restriction")
}

// Danh mục ICD-10 — TOÀN HỆ THỐNG (cùng bản chất province/ward/permission), không tenant_id,
// không đủ 8 cột bắt buộc, không version. Read-only lúc chạy (khác reference_catalog — không có
// endpoint create/update/delete): danh mục Bộ Y tế, seed từ file chính thức chủ dự án cung cấp
// (docs/data/icd10-chuong-1.md). Chỉ seed Chương I trước (S3-01, mở khoá một phần) — các chương
// khác bổ sung dần sau qua cùng cơ chế seed idempotent (skipDuplicates), không migration lại.
// `searchKey` tái dùng nguyên hàm `nexamed_unaccent_lower()` đã có từ patient (S2-02) — không định
// nghĩa lại. `code === groupCode` đánh dấu dòng "Nhóm bệnh" (3 ký tự); các dòng khác là mã chi
// tiết 4-5 ký tự thuộc nhóm đó.
model Icd10Catalog {
  code      String  @id
  nameVi    String  @map("name_vi")
  nameEn    String? @map("name_en")
  // Generated column ở DB (GENERATED ALWAYS AS ... STORED) — không truyền lúc create/update.
  searchKey String? @map("search_key")

  chapterCode String @map("chapter_code")
  chapterName String @map("chapter_name")
  blockCode   String @map("block_code")
  blockName   String @map("block_name")
  groupCode   String @map("group_code")
  groupName   String @map("group_name")

  isBillable        Boolean                 @default(true) @map("is_billable")
  genderRestriction Icd10GenderRestriction? @map("gender_restriction")
  usageRestriction  Icd10UsageRestriction?  @map("usage_restriction")
  whoNote           String?                 @map("who_note")

  diagnoses              Diagnosis[]
  patientConditions      PatientCondition[]
  patientFamilyHistories PatientFamilyHistory[]

  @@index([chapterCode])
  @@index([groupCode])
  @@map("icd10_catalog")
}

enum DataScope {
  none
  personal
  department
  global

  @@map("data_scope")
}

// Ma trận phân quyền: (role, permission) -> data_scope. Xem security-audit.md để biết
// bảng giá trị mặc định seed cho 5 vai trò hệ thống.
model RolePermission {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  permissionId String    @map("permission_id") @db.Uuid
  dataScope    DataScope @map("data_scope")

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  // Composite FK (tenant_id, role_id) -> role(tenant_id, id): chống trỏ chéo tenant.
  role       Role       @relation(fields: [tenantId, roleId], references: [tenantId, id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([tenantId, roleId, permissionId])
  @@map("role_permission")
}

model UserRole {
  id       String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  roleId   String @map("role_id") @db.Uuid

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  // Composite FK (tenant_id, user_id) -> user_account(tenant_id, id) và
  // (tenant_id, role_id) -> role(tenant_id, id): không thể trỏ sang tenant khác kể cả
  // khi code service sai.
  userAccount UserAccount @relation(fields: [tenantId, userId], references: [tenantId, id])
  role        Role        @relation(fields: [tenantId, roleId], references: [tenantId, id])

  // UNIQUE(tenant_id, user_id, role_id) là PARTIAL (WHERE deleted_at IS NULL) — thêm ở S2-07 khi
  // gán lại vai trò (soft-delete gán cũ + tạo dòng mới) mới thật sự cần: unique thường sẽ chặn
  // gán lại đúng vai trò đã từng bị gỡ trước đó (dòng cũ đã soft-delete vẫn tính vào unique
  // thường). Không khai báo được `@@unique` có `WHERE` bằng Prisma schema (giống C3
  // `patient.national_id_hash`) — viết raw SQL trong migration, không khai báo ở đây.
  @@map("user_role")
}

// Phiên "phá kính" — vượt quyền tạm thời khi bị chặn bởi data_scope. Append-only như
// audit_log (không updated_at/deleted_at/version/created_by/updated_by) — xem
// security-audit.md mục Break-glass.
model BreakGlassSession {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  reason     String
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("break_glass_session")
}

model CodeSequence {
  id           String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  prefix       String
  // "Cấu hình mẫu mã phát sinh" (docs/DECISIONS.md #114, 2026-09-03) — chu kỳ reset bộ đếm khi
  // khuôn mẫu có token ngày/tháng/năm ('' = không reset, chạy liên tục — ĐÚNG hành vi mặc định
  // cũ trước #114, mọi dòng hiện có tự nhận '' qua @default nên không cần backfill). Ví dụ
  // "202609" (theo tháng), "2026" (theo năm), "20260903" (theo ngày). Xem
  // packages/shared/src/business-code.ts (computeBusinessCodePeriodKey).
  periodKey    String @default("") @map("period_key")
  currentValue BigInt @default(0) @map("current_value")

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, prefix, periodKey])
  @@map("code_sequence")
}

// Cấp số tuần tự cho mã NGẮN của danh mục TOÀN HỆ THỐNG (reference_catalog 6 category không có
// nguồn dữ liệu chính thức, allergen_group/allergen — docs/DECISIONS.md #113, 2026-09-03) — khác
// `CodeSequence` ở trên (theo tenant, dùng cho mã nghiệp vụ có tháng-năm). Không tenant_id (đúng
// bản chất `reference_catalog`/`allergen_group` mà bảng này phục vụ), cùng cơ chế atomic
// `INSERT ... ON CONFLICT DO UPDATE` qua `prefix` (GlobalCodeSequenceRepository). Thuần hạ tầng
// đếm số, không phải dữ liệu nghiệp vụ hiển thị — miễn trừ 8 cột bắt buộc giống `Permission`
// (scripts/check-mandatory-columns.mjs).
model GlobalCodeSequence {
  id           String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  prefix       String @unique
  currentValue BigInt @default(0) @map("current_value")

  @@map("global_code_sequence")
}

// Hồ sơ hành chính bệnh nhân (S2-01, PAT-01) — xem .claude/docs/data-model.md, docs/ERD.md.
// `nationalIdEnc`/`nationalIdHash`: mã hoá AES-256-GCM + hash HMAC-SHA256 tra trùng
// (apps/api/src/infrastructure/crypto/pii-encryption.ts), CCCD tuỳ chọn (PAT-01) nên cả hai
// nullable. `addressJson`/`identityVerifiedAt`: thêm ở S2-01 để vá lệch ERD.md/data-model.md
// (docs/DECISIONS.md #024) — `identityVerifiedAt` luôn null ở v1, chuẩn bị cho liên-tenant v3+
// cùng `globalPatientRef`. Unique `(tenantId, nationalIdHash)` WHERE NOT NULL không biểu diễn
// được bằng Prisma schema (partial unique index) — thêm bằng raw SQL trong migration.
model Patient {
  id                    String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  patientCode           String    @map("patient_code")
  fullName              String    @map("full_name")
  dob                   DateTime  @db.Date
  gender                String
  phone                 String
  nationalIdEnc         Bytes?    @map("national_id_enc")
  nationalIdHash        String?   @map("national_id_hash")
  addressJson           Json?     @map("address_json") @db.JsonB
  allergyNote           String?   @map("allergy_note")
  // Tiền sử bản thân/gia đình (docs/DECISIONS.md #068) — chuyển từ `clinical_note` (gắn từng lượt
  // khám) sang đây, đúng khuôn `allergyNote`: dữ liệu chung, ít đổi, sửa tại chỗ qua
  // `PATCH /patients/:id`, không nhập lại từ đầu mỗi lượt khám mới.
  personalHistory       String?   @map("personal_history")
  familyHistory         String?   @map("family_history")
  mergedIntoId          String?   @map("merged_into_id") @db.Uuid
  globalPatientRef      String?   @map("global_patient_ref") @db.Uuid
  identityVerifiedAt    DateTime? @map("identity_verified_at") @db.Timestamptz(6)
  // Mở rộng hồ sơ hành chính (docs/DECISIONS.md #034) — tất cả nullable, không backfill, không
  // ràng buộc DB mới. `insuranceNumber` độc lập với module `insurance_card` (S2-04, chưa làm) —
  // chỉ lưu/hiển thị.
  photoKey              String?   @map("photo_key")
  nationalIdIssuedAt    DateTime? @map("national_id_issued_at") @db.Date
  nationalIdIssuedPlace String?   @map("national_id_issued_place")
  // `ethnicity`/`nationality`/`occupation` lưu CODE tham chiếu `reference_catalog` (category
  // ETHNICITY/NATIONALITY/OCCUPATION) — không FK cứng (cùng lý do reference_catalog không có
  // tenant_id, xem comment model ReferenceCatalog). Vẫn String? thuần để không chặn hồ sơ cũ có
  // giá trị text tự do trước khi danh mục hoá (web tự chèn "legacy value" vào Combobox).
  ethnicity             String?
  nationality           String?
  occupation            String?
  insuranceNumber       String?   @map("insurance_number")
  relativeFullName      String?   @map("relative_full_name")
  relativeRelationship  String?   @map("relative_relationship")
  relativePhone         String?   @map("relative_phone")
  relativeAddress       String?   @map("relative_address")
  // Cột dẫn xuất (S2-02, PAT-02) — Postgres GENERATED ALWAYS AS (...) STORED từ full_name (bỏ
  // dấu + viết thường qua hàm nexamed_unaccent_lower(), xem migration `*_patient_search`).
  // KHÔNG bao giờ ghi trực tiếp field này từ Prisma (DB tự tính, ghi vào sẽ lỗi) —
  // PatientRepository không đưa searchKey vào bất kỳ `data: {...}` create/update nào. Khai báo
  // `String?` (không phải `String`) dù thực tế DB không bao giờ null (full_name NOT NULL) — chỉ
  // để Prisma không bắt buộc field này trong `PatientCreateInput`/`PatientUncheckedCreateInput`
  // (Prisma không có khái niệm "generated column, chỉ đọc" nên coi mọi field NOT NULL là bắt
  // buộc phải truyền lúc tạo).
  searchKey             String?   @map("search_key")

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant            Tenant                 @relation(fields: [tenantId], references: [id])
  // Composite FK (tenant_id, merged_into_id) -> patient(tenant_id, id): luồng gộp hồ sơ trùng
  // (PAT-04, chưa hiện thực ở S2-01) — bản ghi nguồn không xoá, chỉ trỏ sang bản ghi đích.
  mergedInto        Patient?               @relation("PatientMerge", fields: [tenantId, mergedIntoId], references: [tenantId, id])
  mergedFrom        Patient[]              @relation("PatientMerge")
  appointments      Appointment[]
  encounters        Encounter[]
  // Dị nguyên đã biết (Sprint 4, chốt 2026-08-25) — xem model PatientAllergen.
  allergens         PatientAllergen[]
  // Bệnh lý nền + thói quen/lối sống, tiền sử gia đình có cấu trúc (Sprint 5) — xem model
  // PatientCondition/PatientFamilyHistory.
  conditions        PatientCondition[]
  familyHistoryRows PatientFamilyHistory[]

  // Đích của composite FK (tenant_id, id) từ appointment/encounter (S2-05, S3) sau này.
  @@unique([tenantId, id])
  @@unique([tenantId, patientCode])
  @@map("patient")
}

enum AppointmentStatus {
  SCHEDULED
  CANCELLED
  NO_SHOW
  CONVERTED
  // Dời lịch (yêu cầu chủ dự án 2026-08-18) — lịch cũ chuyển sang trạng thái này, KHÔNG sửa tại
  // chỗ như bản PATCH reschedule cũ (S2-09). Một lịch mới được tạo riêng cho ngày/giờ mới, trỏ về
  // lịch này qua `rescheduledFromId` (xem dưới) — cùng khuôn `prescription.supersedesId`.
  RESCHEDULED

  @@map("appointment_status")
}

enum AppointmentSource {
  walk_in
  phone
  online

  @@map("appointment_source")
}

// Lịch hẹn (S2-05, APP-01/02/03) — xem .claude/docs/clinical-workflow.md mục "Đặt lịch",
// docs/ERD.md mục 3.3/4. `roomId` nullable: đặt lịch qua điện thoại/online chưa chắc gán phòng
// ngay (module `tenant`/cấu hình phòng là S2-07, chưa tồn tại lúc này) — không phải yêu cầu đã
// chốt, chỉ là lựa chọn ít ràng buộc hơn, dễ siết lại (thêm NOT NULL) hơn là nới lỏng sau.
// Chống trùng giờ bác sĩ (C2, docs/ERD.md mục 4) dùng EXCLUDE USING gist — Prisma không hỗ trợ
// cú pháp EXCLUDE constraint nên thêm bằng raw SQL trong migration, không khai báo được ở đây.
//
// Đổi mô hình đặt lịch (docs/DECISIONS.md #032): không tạo/gắn `patient` lúc đặt — chỉ ghi nhận
// `fullName`/`phone`/`reason` trực tiếp trên `appointment` ("lead capture"), có `bookingCode` để
// khách trình lúc đến. `patientId` chuyển thành nullable — để sẵn cho Tiếp nhận (Sprint 3) gắn
// hồ sơ `patient` thật lúc check-in, chưa có luồng nào ghi giá trị này ở v1 hiện tại.
model Appointment {
  id                String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  patientId         String?           @map("patient_id") @db.Uuid
  doctorId          String            @map("doctor_id") @db.Uuid
  roomId            String?           @map("room_id") @db.Uuid
  bookingCode       String            @map("booking_code")
  fullName          String            @map("full_name")
  phone             String
  reason            String?
  scheduledAt       DateTime          @map("scheduled_at") @db.Timestamptz(6)
  durationMinutes   Int               @map("duration_minutes")
  status            AppointmentStatus @default(SCHEDULED)
  source            AppointmentSource
  cancelReason      String?           @map("cancel_reason")
  // Dời lịch (2026-08-18): lịch MỚI trỏ về lịch CŨ đã bị đánh dấu RESCHEDULED — cùng hướng trỏ
  // với `prescription.supersedesId`/`patient.mergedIntoId` (bản mới/đích trỏ về bản cũ/nguồn,
  // không phải ngược lại). Không có unique constraint (kể cả partial) — cùng lựa chọn đã có ở
  // `patient.mergedIntoId`, chấp nhận rủi ro lý thuyết vì service là nơi duy nhất ghi cột này.
  rescheduledFromId String?           @map("rescheduled_from_id") @db.Uuid

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  // Composite FK (tenant_id, patient_id/doctor_id/room_id) -> ...(tenant_id, id): chống trỏ chéo
  // tenant (C5, docs/ERD.md mục 4), room_id/patient_id nullable nên FK chỉ áp khi có giá trị.
  patient         Patient?      @relation(fields: [tenantId, patientId], references: [tenantId, id])
  doctor          UserAccount   @relation("AppointmentDoctor", fields: [tenantId, doctorId], references: [tenantId, id])
  room            Room?         @relation(fields: [tenantId, roomId], references: [tenantId, id])
  // Composite FK (tenant_id, rescheduled_from_id) -> appointment(tenant_id, id) — cùng khuôn
  // Patient.mergedInto/mergedFrom (self-relation, phía "nhiều" khai List vì Prisma không biết đây
  // thực ra là 1-1 khi không có unique constraint).
  rescheduledFrom Appointment?  @relation("AppointmentReschedule", fields: [tenantId, rescheduledFromId], references: [tenantId, id])
  rescheduledTo   Appointment[] @relation("AppointmentReschedule")
  // Prisma bắt buộc khai báo back-relation cho field `Encounter.appointment` — khai dạng LIST
  // (không phải `Encounter?`) vì `appointmentId` không có `@unique` ở phía Prisma (constraint thật
  // là partial unique index raw SQL trên `encounter(tenant_id, appointment_id)`, xem migration —
  // cùng lý do `patient.nationalIdHash` không khai `@unique`). Prisma không biết đây thực ra là
  // quan hệ một-một; DB tự ép đúng ngữ nghĩa đó. Không có nơi nào cần điều hướng qua field này —
  // ReceptionRepository/EncounterRepository tự truy vấn theo `appointmentId`.
  encounters      Encounter[]

  @@unique([tenantId, id])
  @@unique([tenantId, bookingCode])
  @@index([tenantId, phone])
  @@map("appointment")
}

enum EncounterStatus {
  SCHEDULED
  CHECKED_IN
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW

  @@map("encounter_status")
}

// S3-05→07 (Khám bệnh) — .claude/docs/clinical-workflow.md mục "Khám bệnh": "Bắt buộc có ít nhất
// một `diagnosis` với `type = primary`". Đúng một PRIMARY/encounter ép bằng unique partial index
// raw SQL (C10, docs/ERD.md) — không biểu diễn được ở Prisma, xem comment trong model Diagnosis.
enum DiagnosisType {
  PRIMARY
  SECONDARY

  @@map("diagnosis_type")
}

// Thay thế 4 mục SOAP (S/O/A/P) bằng nhóm "Tiền sử"/"Thăm khám" — yêu cầu chủ dự án 2026-08-20, xem
// docs/DECISIONS.md (entry sau #059). PERSONAL_HISTORY/FAMILY_HISTORY đã CHUYỂN sang
// `patient.personalHistory`/`patient.familyHistory` (docs/DECISIONS.md #068, cùng lý do dị ứng đọc/
// ghi thẳng patient.allergyNote không qua bảng này) — dữ liệu chung của bệnh nhân, không gắn theo
// từng lượt khám. REASON_FOR_VISIT/ILLNESS_PROGRESS/PRELIMINARY_DIAGNOSIS/GENERAL_EXAM/
// REGIONAL_EXAM thuộc nhóm "Thăm khám". PLAN để sẵn cho tab "Kế hoạch điều trị & hẹn tái khám" (chưa
// xây, xem EncounterConsultationPage.tsx TABS).
enum ClinicalNoteSection {
  REASON_FOR_VISIT
  ILLNESS_PROGRESS
  PRELIMINARY_DIAGNOSIS
  GENERAL_EXAM
  REGIONAL_EXAM
  PLAN

  @@map("clinical_note_section")
}

// Lượt khám (Sprint 3, REC-01→03) — xem .claude/docs/clinical-workflow.md mục "Tiếp nhận
// (check-in)", docs/ERD.md mục 3.3. Bảng trung tâm: sinh hiệu/chẩn đoán/ghi chú/đơn thuốc đều trỏ
// về encounter_id (chưa xây ở PR này — đó là module `encounter` giai đoạn Khám bệnh sau).
//
// v1 chỉ tạo dòng thẳng ở status=CHECKED_IN qua ReceptionService.checkIn() (đọc appointment đã
// SCHEDULED, tạo encounter, chuyển appointment sang CONVERTED — cùng 1 transaction). Enum vẫn đủ
// 6 giá trị theo state machine đã chốt (packages/core/src/encounter/encounter-state-machine.ts)
// dù SCHEDULED/NO_SHOW hiện chưa có luồng nào ghi tới cho riêng bảng này.
model Encounter {
  id                    String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId              String          @map("tenant_id") @db.Uuid
  patientId             String          @map("patient_id") @db.Uuid
  // "Hàng đợi ảo" (#064) — nullable: lượt khám còn trong hàng chờ chung Khoa (`departmentId`,
  // dưới) chưa được bác sĩ nào nhận thì `doctorId=NULL`. "Của tôi" = `doctorId=actor`; "Nhận ca"
  // (`POST /encounters/:id/start`) set `doctorId` lúc pull từ hàng chờ chung.
  doctorId              String?         @map("doctor_id") @db.Uuid
  // "Hàng đợi ảo" (#064) — BẮT BUỘC, khác doctorId (nullable). Suy từ Khoa của bác sĩ đã chọn lúc
  // Tiếp nhận, hoặc là Khoa client chọn thẳng khi routing "theo Khoa (chưa rõ bác sĩ)". Mọi tenant
  // luôn có sẵn ít nhất 1 Khoa mặc định ("Khoa chung", seed lúc tạo tenant) nên cột này không bao
  // giờ thiếu giá trị hợp lệ để gán.
  departmentId          String          @map("department_id") @db.Uuid
  // Không @unique ở đây — constraint thật là partial unique index raw SQL (WHERE appointment_id
  // IS NOT NULL AND deleted_at IS NULL, xem migration), Prisma không biểu diễn được unique có điều
  // kiện WHERE (cùng lý do patient.nationalIdHash không khai @unique).
  appointmentId         String?         @map("appointment_id") @db.Uuid
  encounterNo           String          @map("encounter_no")
  status                EncounterStatus
  specialty             String          @default("general")
  checkedInAt           DateTime        @map("checked_in_at") @db.Timestamptz(6)
  startedAt             DateTime?       @map("started_at") @db.Timestamptz(6)
  completedAt           DateTime?       @map("completed_at") @db.Timestamptz(6)
  chiefComplaint        String?         @map("chief_complaint")
  // Bản chụp thẻ BHYT tại thời điểm check-in — v1 luôn { selfPay: true } (module insurance_card/
  // S2-04 chưa làm, xem docs/DECISIONS.md #032/mới). Đúng tên cột theo docs/ERD.md.
  insuranceSnapshot     Json            @map("insurance_snapshot") @db.JsonB
  // "Bỏ về" (CHECKED_IN→CANCELLED, bắt buộc lý do) — không soft-delete, cùng khuôn
  // appointment.cancelReason. Bổ sung ngoài docs/ERD.md gốc, xem migration + docs/DECISIONS.md.
  cancelReason          String?         @map("cancel_reason")
  // "Tiếp nhận bệnh nhân" (tạo encounter trực tiếp, appointmentId=null) — mã danh mục
  // PATIENT_SOURCE đã chọn, tuỳ chọn. Cùng convention patient.ethnicity: lưu code, không lưu tên.
  patientSourceCode     String?         @map("patient_source_code")
  // DEPRECATED (docs/DECISIONS.md #080) — "Chỉ định dịch vụ khám" chuyển từ 1 dịch vụ/lượt khám
  // sang danh sách nhiều dòng ở bảng con `EncounterServiceItem` bên dưới. 6 cột này GIỮ NGUYÊN
  // trong DB (dữ liệu cũ trước #080 vẫn đọc được) nhưng luồng Tiếp nhận mới NGỪNG ghi — cùng cách
  // đã làm với patient.familyHistory/allergyNote (#065/#068). Không xoá cột, không migration.
  examTypeCode          String?         @map("exam_type_code")
  examTypeName          String?         @map("exam_type_name")
  examTypePrice         BigInt?         @map("exam_type_price")
  // Thiết kế lại "Tiếp nhận bệnh nhân" (mockup đã duyệt) — Loại tiếp nhận/Hình thức khám (mã danh
  // mục RECEPTION_TYPE/EXAM_FORM), Ưu tiên khám + lý do (PRIORITY_REASON, bắt buộc kèm khi có ưu
  // tiên — ràng buộc ở packages/shared, không phải DB). Tất cả nullable ở DB (áp dụng dần cho
  // encounter mới, không phá dữ liệu cũ).
  receptionTypeCode     String?         @map("reception_type_code")
  examFormCode          String?         @map("exam_form_code")
  isPriority            Boolean         @default(false) @map("is_priority")
  priorityReasonCode    String?         @map("priority_reason_code")
  // DEPRECATED (docs/DECISIONS.md #080) — cùng lý do 3 cột exam_type_* ở trên, thay bằng
  // EncounterServiceItem.priceTypeCode/unitCode/quantity (nhiều dòng).
  priceTypeCode         String?         @map("price_type_code")
  examTypeUnit          String?         @map("exam_type_unit")
  serviceQuantity       Int             @default(1) @map("service_quantity")
  // Thu ngân cơ bản (Sprint 5/6, BIL-01→04) — ý nghĩa checkbox "Thanh toán sau" ở Tiếp nhận đã ghi
  // nhận từ #080, nay có nghĩa thật: true = lượt khám được PHÉP vào Hàng đợi khám dù invoice chưa
  // PAID. Chỉ có hiệu lực khi tenant_setting `deferred_payment_enabled=true` (EncounterService đọc
  // qua ClinicConfigReaderPort, AND lại 2 điều kiện lúc gate — tắt tính năng ở cấp phòng khám thì
  // cột này bị bỏ qua, luôn coi như false). Mặc định false — an toàn cho dữ liệu cũ (encounter tạo
  // trước tính năng này chưa từng có invoice nên gate không áp hồi tố).
  allowsDeferredPayment Boolean         @default(false) @map("allows_deferred_payment")

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant        Tenant                 @relation(fields: [tenantId], references: [id])
  // Composite FK (tenant_id, patient_id/doctor_id/appointment_id) -> ...(tenant_id, id): chống trỏ
  // chéo tenant (C5, docs/ERD.md mục 4), appointment_id nullable nên FK chỉ áp khi có giá trị.
  patient       Patient                @relation(fields: [tenantId, patientId], references: [tenantId, id])
  // doctorId nullable — FK chỉ áp khi có giá trị (Postgres MATCH SIMPLE, cùng mẫu room.floorId).
  doctor        UserAccount?           @relation("EncounterDoctor", fields: [tenantId, doctorId], references: [tenantId, id])
  department    Department             @relation(fields: [tenantId, departmentId], references: [tenantId, id])
  appointment   Appointment?           @relation(fields: [tenantId, appointmentId], references: [tenantId, id])
  vitalSigns    VitalSign[]
  serviceItems  EncounterServiceItem[]
  diagnoses     Diagnosis[]
  clinicalNotes ClinicalNote[]
  prescriptions Prescription[]
  // Thu ngân cơ bản — tối đa 1 phiếu thu/lượt khám (BIL-01, PRD mục 4.7), @@unique([tenantId,
  // encounterId]) khai ở model Invoice bên dưới.
  invoice       Invoice?

  @@unique([tenantId, id])
  @@unique([tenantId, encounterNo])
  // S5-05/S5-06 — tra "các lượt khám thuộc bệnh nhân X" (nhật ký hoạt động theo bệnh nhân, gộp hồ sơ).
  @@index([tenantId, patientId])
  @@map("encounter")
}

// "Chỉ định dịch vụ khám" (docs/DECISIONS.md #080) — danh sách nhiều dịch vụ/lượt khám, thay cho
// 6 cột exam_type_*/price_type_code/... đã deprecated trên Encounter (xem comment ở model trên).
// Sub-resource sở hữu bởi module `reception` (đúng khuôn VitalSign — KHÔNG có khái niệm ký/bất
// biến như PrescriptionItem). Mọi field SNAPSHOT tại thời điểm thêm (copy từ reference_catalog/
// exam_type_price lúc chọn trên web, không JOIN lại lúc đọc) — cùng tinh thần insuranceSnapshot.
// priceTypeCode/unitCode/examTypePrice nullable: dịch vụ chưa được cấu hình đơn giá hiệu lực ở
// exam_type_price vẫn thêm được (mục này chỉ lưu để hiển thị, KHÔNG tính viện phí — CLAUDE.md).
model EncounterServiceItem {
  id            String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  encounterId   String  @map("encounter_id") @db.Uuid
  examTypeCode  String  @map("exam_type_code")
  examTypeName  String  @map("exam_type_name")
  priceTypeCode String? @map("price_type_code")
  unitCode      String? @map("unit_code")
  examTypePrice BigInt? @map("exam_type_price")
  quantity      Int     @default(1)

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  // Composite FK (tenant_id, encounter_id) -> encounter(tenant_id, id): chống trỏ chéo tenant.
  encounter    Encounter     @relation(fields: [tenantId, encounterId], references: [tenantId, id])
  // Thu ngân cơ bản — InvoiceLine.sourceServiceItem trỏ ngược lại đây (biết nguồn gốc dòng tiền).
  invoiceLines InvoiceLine[]

  @@unique([tenantId, id])
  @@map("encounter_service_item")
}

// Sinh hiệu (Sprint 3, REC-02/03) — xem docs/ERD.md mục 3.4 (khối VITAL_SIGN), .claude/docs/
// data-model.md. Số nguyên: nhiệt độ theo phần mười độ C (37.5°C → 375), cân nặng theo gram,
// chiều cao theo mm — tránh số thực. Mọi cột đo NULLABLE (cho phép nhập từng phần, không bắt buộc
// đủ mọi chỉ số trong một lần ghi). Không có cột `measured_by` riêng (chỉ có trong mô tả tóm tắt
// lệch của data-model.md, không có trong ERD.md chi tiết — dùng `created_by` sẵn có, xem
// docs/DECISIONS.md).
model VitalSign {
  id               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  encounterId      String   @map("encounter_id") @db.Uuid
  pulse            Int?     @db.SmallInt
  temperatureDeciC Int?     @map("temperature_deci_c") @db.SmallInt
  bpSystolic       Int?     @map("bp_systolic") @db.SmallInt
  bpDiastolic      Int?     @map("bp_diastolic") @db.SmallInt
  respiratoryRate  Int?     @map("respiratory_rate") @db.SmallInt
  spo2             Int?     @db.SmallInt
  weightGram       Int?     @map("weight_gram")
  heightMm         Int?     @map("height_mm")
  measuredAt       DateTime @map("measured_at") @db.Timestamptz(6)

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  // Composite FK (tenant_id, encounter_id) -> encounter(tenant_id, id): chống trỏ chéo tenant.
  encounter Encounter @relation(fields: [tenantId, encounterId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@map("vital_sign")
}

// Chẩn đoán (S3-05→07) — docs/ERD.md mục 3.4 (khối DIAGNOSIS). Đúng một PRIMARY/encounter (C10) —
// unique partial index raw SQL trong migration (WHERE type='PRIMARY' AND deleted_at IS NULL),
// không khai @unique ở đây (Prisma không biểu diễn được unique có điều kiện WHERE, cùng lý do
// patient.nationalIdHash/encounter.appointmentId).
model Diagnosis {
  id              String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  encounterId     String        @map("encounter_id") @db.Uuid
  // FK thường (không composite) tới icd10_catalog.code — danh mục toàn hệ thống, không có tenant_id.
  icd10Code       String        @map("icd10_code")
  type            DiagnosisType
  note            String?
  // Ký hồ sơ khám (Sprint 5, S5-02/03) — "Hoàn tất khám" tự động ký, đúng khuôn `Prescription`.
  // Đính chính ghép supersedesId theo (icd10Code, type) không đổi — xem `pairDiagnosisAmendment`.
  signedAt        DateTime?     @map("signed_at") @db.Timestamptz(6)
  signedBy        String?       @map("signed_by") @db.Uuid
  supersedesId    String?       @map("supersedes_id") @db.Uuid
  amendmentReason String?       @map("amendment_reason")

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  // Composite FK (tenant_id, encounter_id) -> encounter(tenant_id, id): chống trỏ chéo tenant.
  encounter    Encounter    @relation(fields: [tenantId, encounterId], references: [tenantId, id])
  icd10        Icd10Catalog @relation(fields: [icd10Code], references: [code])
  supersedes   Diagnosis?   @relation("DiagnosisAmendment", fields: [tenantId, supersedesId], references: [tenantId, id])
  supersededBy Diagnosis[]  @relation("DiagnosisAmendment")

  @@unique([tenantId, id])
  @@map("diagnosis")
}

// Ghi chú khám (S3-05→07, đổi từ 4 mục SOAP sang 8 mục nhóm Tiền sử/Thăm khám — xem enum
// ClinicalNoteSection) — docs/ERD.md mục 3.4 (khối CLINICAL_NOTE), .claude/docs/
// clinical-workflow.md mục "Amendment hồ sơ". MỘT DÒNG/section/encounter (unique partial WHERE
// deleted_at IS NULL trong migration — cơ sở cho upsert tìm-hoặc-tạo). `signedAt`/`signedBy`/
// `supersedesId`/`amendmentReason` (Sprint 5, S5-02/03) — "Hoàn tất khám" tự động ký TẤT CẢ section
// đang hiệu lực; sửa sau khi ký phải qua `POST .../clinical-note/amend` (đính chính, bắt buộc lý
// do, đúng 1-1 theo section — khác `Diagnosis` là danh sách không có "slot" cố định).
model ClinicalNote {
  id              String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  encounterId     String              @map("encounter_id") @db.Uuid
  section         ClinicalNoteSection
  content         String
  signedAt        DateTime?           @map("signed_at") @db.Timestamptz(6)
  signedBy        String?             @map("signed_by") @db.Uuid
  supersedesId    String?             @map("supersedes_id") @db.Uuid
  amendmentReason String?             @map("amendment_reason")

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  // Composite FK (tenant_id, encounter_id) -> encounter(tenant_id, id): chống trỏ chéo tenant.
  encounter    Encounter      @relation(fields: [tenantId, encounterId], references: [tenantId, id])
  supersedes   ClinicalNote?  @relation("ClinicalNoteAmendment", fields: [tenantId, supersedesId], references: [tenantId, id])
  supersededBy ClinicalNote[] @relation("ClinicalNoteAmendment")

  @@unique([tenantId, id])
  @@map("clinical_note")
}

// Danh mục thuốc (Sprint 4, S4-03) — THEO TENANT, phòng khám tự nhập (PRD mục 8, khác
// icd10_catalog/allergen_catalog toàn hệ thống). "Trường hợp A" đã chốt (docs/DECISIONS.md
// 2026-08-25): không tồn kho, không giá bán — chỉ đủ để ghi nhận/tìm kiếm lúc kê đơn. Khi có kho
// thuốc thật (v2.1), thêm bảng riêng tham chiếu tới đây, không sửa bảng này (xem
// docs/product/future-modules-reference.md mục 2.2.1).
model Drug {
  id               String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  code             String
  name             String
  activeIngredient String? @map("active_ingredient")
  unit             String?
  concentration    String?
  isActive         Boolean @default(true) @map("is_active")

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  prescriptionItems PrescriptionItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("drug")
}

// Đơn thuốc (Sprint 4, S4-01/02/04) — .claude/docs/clinical-workflow.md mục "Kê đơn (v1: chỉ in
// đơn)": tạo được khi encounter IN_CONSULTATION và đã có chẩn đoán chính; NHÁP (signedAt=null, sửa
// tự do qua bulk-replace prescriptionItems) cho tới khi ký; ký xong BẤT BIẾN (trigger C8 chặn UPDATE
// khi signed_at IS NOT NULL — lần đầu tiên trong dự án, xem migration), sửa = đính chính (bản ghi
// mới supersedesId trỏ về bản cũ, bản cũ soft-delete). signaturePayload luôn NULL ở v1 (chữ ký
// logic qua SignaturePort no-op).
model Prescription {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  encounterId      String    @map("encounter_id") @db.Uuid
  signedAt         DateTime? @map("signed_at") @db.Timestamptz(6)
  signedBy         String?   @map("signed_by") @db.Uuid
  signaturePayload Bytes?    @map("signature_payload")
  printedAt        DateTime? @map("printed_at") @db.Timestamptz(6)
  supersedesId     String?   @map("supersedes_id") @db.Uuid
  amendmentReason  String?   @map("amendment_reason")

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  // Composite FK (tenant_id, encounter_id) -> encounter(tenant_id, id): chống trỏ chéo tenant.
  encounter    Encounter          @relation(fields: [tenantId, encounterId], references: [tenantId, id])
  items        PrescriptionItem[]
  // Self-relation đính chính — cùng khuôn patient.mergedInto/mergedFrom, appointment.rescheduledFrom.
  // Không @unique ở supersedesId (chấp nhận rủi ro lý thuyết, cùng lựa chọn patient.mergedIntoId).
  supersedes   Prescription?      @relation("PrescriptionAmendment", fields: [tenantId, supersedesId], references: [tenantId, id])
  supersededBy Prescription[]     @relation("PrescriptionAmendment")

  @@unique([tenantId, id])
  @@map("prescription")
}

model PrescriptionItem {
  id             String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  prescriptionId String  @map("prescription_id") @db.Uuid
  drugId         String  @map("drug_id") @db.Uuid
  dose           String
  frequency      String
  durationDays   Int     @map("duration_days") @db.SmallInt
  quantity       Int
  instruction    String?

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  // Composite FK (tenant_id, prescription_id/drug_id) -> ...(tenant_id, id): chống trỏ chéo tenant.
  prescription Prescription @relation(fields: [tenantId, prescriptionId], references: [tenantId, id])
  drug         Drug         @relation(fields: [tenantId, drugId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@map("prescription_item")
}

// CANCELLED/REFUNDED thêm ở #085 (huỷ lượt khám + hoàn tiền) — xem comment model Invoice bên dưới.
enum InvoiceStatus {
  UNPAID
  PAID
  CANCELLED
  REFUNDED

  @@map("invoice_status")
}

// Tách "thu vào" khỏi "trả ra" trên cùng bảng payment (#085). KHÔNG dùng amount âm — cột `type`
// tường minh cho phép SUM theo nhóm ở tổng kết cuối ngày mà không phải phân nhánh theo dấu.
enum PaymentType {
  PAYMENT
  REFUND

  @@map("payment_type")
}

// Phiếu thu (Sprint 5/6, Thu ngân cơ bản, BIL-01→04) — .claude/docs/clinical-workflow.md mục
// "Tiếp nhận": ĐÚNG 1 phiếu thu/lượt khám, tự động tạo trong CÙNG transaction với check-in/tiếp
// nhận trực tiếp (ReceptionService), snapshot từ EncounterServiceItem có giá tại thời điểm đó —
// KHÔNG tạo nếu không có dòng dịch vụ nào có giá (không có gì để thu). "Đã thu"/"Chưa thu"
// (status) là NGUỒN SỰ THẬT cho gating "Hàng đợi khám" theo thanh toán (kết hợp
// Encounter.allowsDeferredPayment + tenant_setting `deferred_payment_enabled`, xem
// EncounterService.startConsultation). KHÔNG dùng SignableEntity/trigger C8 kiểu Prescription —
// phạm vi "mức 1" của #072 không có amendment, khoá sửa invoice_line khi status=PAID chỉ ở tầng
// service (không phải hồ sơ lâm sàng, không bắt buộc theo Thông tư 46/2018/TT-BYT).
// #085 (huỷ lượt khám + hoàn tiền) — status nay 4 giá trị:
//   UNPAID ──thu tiền──> PAID ──hoàn tiền──> REFUNDED
//      └──huỷ lượt khám──> CANCELLED
// CANCELLED (huỷ khi chưa thu) rớt khỏi tab "Chờ thu" + tổng kết cuối ngày nhưng VẪN tra cứu lại
// được theo mã phiếu (khác soft-delete — phiếu có thể đã in đưa khách trước khi huỷ). Huỷ lượt
// khám khi đã PAID thì status GIỮ NGUYÊN PAID (không tự nhảy REFUNDED) — hoàn tiền là thao tác
// riêng cần quyền `invoice.refund`, xem InvoiceService.refund().
// pendingPaymentMethod/pendingCashReceivedAmount = "Lưu tạm" (F8) trên màn Chi tiết thanh toán —
// lễ tân đang nhập dở (chọn phương thức/gõ tiền khách đưa) mà chưa bấm "Thu tiền", lưu lại để mở
// tiếp đúng chỗ (kể cả người/máy khác) — KHÔNG phải trạng thái nghiệp vụ (status vẫn UNPAID), xoá
// sạch khi markPaid() thành công.
model Invoice {
  id                        String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId                  String        @map("tenant_id") @db.Uuid
  encounterId               String        @map("encounter_id") @db.Uuid
  invoiceNo                 String        @map("invoice_no")
  status                    InvoiceStatus @default(UNPAID)
  totalAmount               BigInt        @map("total_amount")
  printedAt                 DateTime?     @map("printed_at") @db.Timestamptz(6)
  // Mã tham chiếu reference_catalog category PAYMENT_METHOD (text, KHÔNG FK cứng — cùng khuôn
  // examTypeCode/priceTypeCode/unitCode, đổi từ Postgres enum cố định sang danh mục quản lý được
  // qua UI, chủ dự án yêu cầu trực tiếp 2026-08-27).
  pendingPaymentMethod      String?       @map("pending_payment_method")
  pendingCashReceivedAmount BigInt?       @map("pending_cash_received_amount")

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  // Composite FK (tenant_id, encounter_id) -> encounter(tenant_id, id): chống trỏ chéo tenant.
  // UNIQUE(tenant_id, encounter_id) (không phải @unique kép — chỉ 1 index duy nhất) ép đúng 1
  // phiếu thu/lượt khám (BIL-01), cũng là FK phía ngược Encounter.invoice ở model trên.
  encounter Encounter     @relation(fields: [tenantId, encounterId], references: [tenantId, id])
  lines     InvoiceLine[]
  payments  Payment[]

  @@unique([tenantId, id])
  @@unique([tenantId, encounterId])
  @@map("invoice")
}

// Snapshot 1 dòng dịch vụ đã tính tiền — sinh tự động từ EncounterServiceItem có
// exam_type_price != NULL lúc tạo Invoice (docs/DECISIONS.md #080: SUM nhiều dòng, bỏ qua dòng
// chưa cấu hình giá). unitPrice/lineTotal snapshot tại thời điểm tạo, KHÔNG JOIN lại exam_type_price
// lúc đọc — cùng tinh thần EncounterServiceItem/insuranceSnapshot.
model InvoiceLine {
  id                  String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId            String  @map("tenant_id") @db.Uuid
  invoiceId           String  @map("invoice_id") @db.Uuid
  sourceServiceItemId String  @map("source_service_item_id") @db.Uuid
  examTypeCode        String  @map("exam_type_code")
  examTypeName        String  @map("exam_type_name")
  priceTypeCode       String? @map("price_type_code")
  unitCode            String? @map("unit_code")
  unitPrice           BigInt  @map("unit_price")
  quantity            Int
  lineTotal           BigInt  @map("line_total")

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant            Tenant               @relation(fields: [tenantId], references: [id])
  // Composite FK (tenant_id, invoice_id) -> invoice(tenant_id, id): chống trỏ chéo tenant.
  invoice           Invoice              @relation(fields: [tenantId, invoiceId], references: [tenantId, id])
  // Composite FK (tenant_id, source_service_item_id) -> encounter_service_item(tenant_id, id):
  // biết nguồn gốc dòng, chống trỏ chéo tenant cùng nguyên tắc mọi FK khác trong file này.
  sourceServiceItem EncounterServiceItem @relation(fields: [tenantId, sourceServiceItemId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@map("invoice_line")
}

// Lịch sử thu tiền của 1 phiếu thu — tách khỏi Invoice (dù v1 luôn tối đa 1 dòng HIỆU LỰC/invoice,
// PRD BIL-03 chỉ cần "đã thu/chưa thu" nhị phân) để không phải đổi schema nếu v2 cần nhiều đợt
// thanh toán/công nợ. "Đánh dấu chưa thu" (huỷ nhầm) = soft-delete dòng payment (deletedReason bắt
// buộc) + Invoice.status quay lại UNPAID — không xoá cứng theo CLAUDE.md.
model Payment {
  id             String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  invoiceId      String      @map("invoice_id") @db.Uuid
  // Mã tham chiếu reference_catalog category PAYMENT_METHOD (text, không FK — xem comment Invoice.pendingPaymentMethod).
  method         String
  // #085 — PAYMENT = tiền khách trả vào; REFUND = tiền hoàn lại khách khi huỷ lượt khám đã thu.
  // Dòng REFUND là dòng SỐNG (deleted_at IS NULL) đối ứng dòng PAYMENT gốc — KHÔNG soft-delete
  // dòng gốc (đó là cơ chế "Đánh dấu chưa thu" cho thao tác BẤM NHẦM, nghĩa hoàn toàn khác).
  type           PaymentType @default(PAYMENT)
  // amount LUÔN dương kể cả dòng REFUND (chiều tiền đọc từ `type`) — v1 chỉ hoàn TOÀN PHẦN nên
  // amount dòng REFUND luôn bằng đúng amount dòng PAYMENT gốc; cột vẫn lưu số thật để mở hoàn một
  // phần sau này không phải đổi schema.
  amount         BigInt
  paidAt         DateTime    @map("paid_at") @db.Timestamptz(6)
  // Lý do hoàn tiền — bắt buộc ở tầng service khi type=REFUND, null với dòng PAYMENT. Khác
  // deletedReason (8 cột bắt buộc): đây là lý do nghiệp vụ in lên phiếu chi cho khách ký nhận.
  reason         String?
  // "Đa thu ngân" (2026-09-04) — ca thu ngân đang mở của người xử lý phiếu này TẠI THỜI ĐIỂM thu/
  // hoàn tiền, nếu có (NULL khi không có ca nào đang mở — không bắt buộc). CHỈ dùng khi tenant BẬT
  // cashierShiftMultiCashierEnabled (CashierShiftService.computeTotals() rẽ nhánh theo cột này vs
  // theo khoảng thời gian) — dòng tạo TRƯỚC khi có cột này luôn NULL, không backfill.
  cashierShiftId String?     @map("cashier_shift_id") @db.Uuid
  // "Thu chi tại quầy" (Sổ quỹ & Thu chi GĐ1) — quỹ nhận/xuất tiền của dòng này, resolve theo
  // `countsAsCash` của `method` lúc thu/hoàn tiền (xem InvoiceService). NULL cho mọi dòng tạo
  // TRƯỚC tính năng này — không backfill, xem comment model CashAccount.
  cashAccountId  String?     @map("cash_account_id") @db.Uuid

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  // Composite FK (tenant_id, invoice_id) -> invoice(tenant_id, id): chống trỏ chéo tenant.
  invoice      Invoice       @relation(fields: [tenantId, invoiceId], references: [tenantId, id])
  // Composite FK (tenant_id, cashier_shift_id) -> cashier_shift(tenant_id, id), NULLABLE.
  cashierShift CashierShift? @relation(fields: [tenantId, cashierShiftId], references: [tenantId, id])
  // Composite FK (tenant_id, cash_account_id) -> cash_account(tenant_id, id), NULLABLE.
  cashAccount  CashAccount?  @relation(fields: [tenantId, cashAccountId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@map("payment")
}

// "Quỹ" (Sổ quỹ & Thu chi GĐ1) — nơi giữ tiền THEO TENANT: quỹ tiền mặt hoặc tài khoản ngân hàng.
// `type` khai sẵn giá trị `DRAWER` (két thu ngân) dù GĐ1 chưa dùng tới — chỉ để GĐ2 bật công tắc
// "Thủ quỹ riêng" (tách két ca khỏi quỹ chính) mà không phải `ALTER TYPE` thêm giá trị enum giữa
// chừng (Postgres không cho dùng giá trị enum mới thêm trong CÙNG transaction đã thêm nó).
// `openingBalance`/`openingBalanceAt` là mốc số dư ban đầu do `clinic_admin` tự khai khi tạo quỹ
// (ví dụ số dư đã có sẵn trước khi dùng phần mềm) — Sổ quỹ (GĐ2) cộng dồn thu/chi TỪ mốc này.
model CashAccount {
  id               String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  // Mã ngắn tự sinh qua CodeSequenceRepository (tenant-scoped, tiền tố "QU"), không nhập tay —
  // đúng khuôn WorkShift.code (docs/DECISIONS.md #113).
  code             String
  name             String
  type             CashAccountType
  bankName         String?         @map("bank_name")
  bankAccountNo    String?         @map("bank_account_no")
  openingBalance   BigInt          @default(0) @map("opening_balance")
  openingBalanceAt DateTime        @map("opening_balance_at") @db.Timestamptz(6)
  isDefault        Boolean         @default(false) @map("is_default")
  isActive         Boolean         @default(true) @map("is_active")

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  payments Payment[]
  vouchers CashVoucher[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("cash_account")
}

enum CashAccountType {
  CASH
  BANK
  // Chưa dùng ở GĐ1 — để sẵn cho công tắc "Thủ quỹ riêng" (GĐ2), xem comment model CashAccount.
  DRAWER

  @@map("cash_account_type")
}

// "Phiếu thu / Phiếu chi" ngoài dịch vụ khám (Sổ quỹ & Thu chi GĐ1, docs/DECISIONS.md) — MỘT bảng
// cho cả 2 chiều tiền, phân biệt bằng `direction` (dùng lại enum `ReferenceCatalogDirection` của
// danh mục "Loại thu chi" — cùng một khái niệm Thu/Chi, giữ một nguồn sự thật, không tạo enum thứ
// hai trùng lặp). Ví dụ: thu tiền bán phế liệu, chi tiền điện/nước — những khoản tiền mặt/chuyển
// khoản KHÔNG gắn với một lượt khám nào (khác `payment`, luôn bắt buộc có `invoice_id`).
model CashVoucher {
  id                    String                    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId              String                    @map("tenant_id") @db.Uuid
  voucherNo             String                    @map("voucher_no")
  direction             ReferenceCatalogDirection
  // Mã tham chiếu reference_catalog category INCOME_EXPENSE_TYPE (text, KHÔNG FK — bảng đó toàn
  // hệ thống không có tenant_id, cùng khuôn payment.method/invoiceLine.examTypeCode).
  incomeExpenseTypeCode String                    @map("income_expense_type_code")
  cashAccountId         String                    @map("cash_account_id") @db.Uuid
  // Mã tham chiếu reference_catalog category PAYMENT_METHOD — countsAsCash của mã này quyết định
  // phiếu có gộp vào tiền mặt đối soát của ca hay không, đúng cơ chế payment.method.
  paymentMethodCode     String                    @map("payment_method_code")
  amount                BigInt
  occurredAt            DateTime                  @map("occurred_at") @db.Timestamptz(6)
  partnerName           String?                   @map("partner_name")
  description           String
  note                  String?
  status                CashVoucherStatus         @default(POSTED)
  approvedBy            String?                   @map("approved_by") @db.Uuid
  approvedAt            DateTime?                 @map("approved_at") @db.Timestamptz(6)
  rejectionReason       String?                   @map("rejection_reason")
  // "Đa thu ngân" — ca thu ngân đang mở của người lập phiếu, nếu có (đúng khuôn payment.cashierShiftId).
  cashierShiftId        String?                   @map("cashier_shift_id") @db.Uuid
  printedAt             DateTime?                 @map("printed_at") @db.Timestamptz(6)

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  // Composite FK (tenant_id, cash_account_id) -> cash_account(tenant_id, id).
  cashAccount  CashAccount   @relation(fields: [tenantId, cashAccountId], references: [tenantId, id])
  // Composite FK (tenant_id, cashier_shift_id) -> cashier_shift(tenant_id, id), NULLABLE.
  cashierShift CashierShift? @relation(fields: [tenantId, cashierShiftId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, voucherNo])
  @@map("cash_voucher")
}

enum CashVoucherStatus {
  POSTED
  PENDING_APPROVAL
  REJECTED

  @@map("cash_voucher_status")
}

enum CashierShiftStatus {
  OPEN
  CLOSED
  APPROVED

  @@map("cashier_shift_status")
}

enum CashierShiftDiscrepancyResolution {
  DEDUCT
  INCOME
  WAIVE

  @@map("cashier_shift_discrepancy_resolution")
}

// "Chốt ca" (đối soát tiền mặt/két, ngoài kế hoạch, mockup duyệt 2026-09-03) — module
// `cashier-shift`. KHÔNG liên quan `work_shift`/`work_shift_assignment` (đăng ký ca làm việc nhân
// viên, #101) dù tên gần giống — đây là phiên làm việc CỦA KÉT TIỀN MẶT (mở/đóng/đối soát), một
// khái niệm hoàn toàn khác. Mặc định: 1 két dùng chung toàn tenant, chỉ 1 ca OPEN tại một thời
// điểm — vốn đầu ca kế thừa từ ca CLOSED gần nhất bất kỳ ai. "Đa thu ngân" (2026-09-04,
// `tenant_setting.cashier_shift_multi_cashier_enabled`, TẮT mặc định): mỗi thu ngân có ca RIÊNG,
// chạy song song — partial unique index đổi từ theo tenant sang theo (tenant_id, cashier_id), vốn
// đầu ca kế thừa từ ca CLOSED gần nhất của CHÍNH người đó.
model CashierShift {
  id         String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId   String             @map("tenant_id") @db.Uuid
  // Mã hiển thị, sinh qua code_sequence (prefix "PCC", packages/shared/src/cashier-shift.ts).
  shiftNo    String             @map("shift_no")
  // Người mở ca — CHỈ đúng người này (hoặc actor có cashier_shift.manage) mới chốt/sửa được, kiểm
  // ở Service (RBAC chỉ gác "được thử", không phân biệt "đúng ca của mình").
  cashierId  String             @map("cashier_id") @db.Uuid
  // "Ca sáng"/"Ca chiều"/"Ca tối" — snapshot tính bằng deriveShiftLabel(openedAt), KHÔNG phải FK
  // tới work_shift (danh mục mẫu ca làm việc nhân viên, #101 — khác bản chất hoàn toàn).
  shiftLabel String             @map("shift_label")
  status     CashierShiftStatus @default(OPEN)

  openedAt                 DateTime @map("opened_at") @db.Timestamptz(6)
  // Vốn ca trước để lại — NULL nếu đây là ca đầu tiên hệ thống (chưa từng có ca CLOSED nào).
  openingFloatExpected     BigInt?  @map("opening_float_expected")
  openingFloatActual       BigInt   @map("opening_float_actual")
  openingDiscrepancyReason String?  @map("opening_discrepancy_reason")

  closedAt             DateTime? @map("closed_at") @db.Timestamptz(6)
  // 3 cột snapshot lúc chốt — tính lại được qua "Tính toán lại" (POST .../edit,
  // resyncSystemTotals=true), KHÔNG sửa tay trực tiếp.
  cashInAmount         BigInt?   @map("cash_in_amount")
  cashOutAmount        BigInt?   @map("cash_out_amount")
  // Mảng {method, count, amount} — snapshot phi tiền mặt lúc chốt, đúng tiền lệ JSON đã dùng
  // (patient.address_json).
  nonCashBreakdownJson Json?     @map("non_cash_breakdown_json") @db.JsonB
  expectedCashAmount   BigInt?   @map("expected_cash_amount")
  // "Thu chi tại quầy" (Sổ quỹ & Thu chi GĐ1) — snapshot lúc chốt, tách riêng phần tiền mặt của
  // `cash_voucher` (status=POSTED) khỏi phần tiền mặt của `payment` (thu/hoàn tiền khám) đã gộp
  // sẵn ở cashInAmount/cashOutAmount — CHỈ để hiển thị tách bạch trên phiếu in, KHÔNG dùng để tính
  // lại expectedCashAmount (công thức đó không đổi). NULL cho ca CLOSED trước tính năng này.
  otherCashInAmount    BigInt?   @map("other_cash_in_amount")
  otherCashOutAmount   BigInt?   @map("other_cash_out_amount")

  // 4 trường sửa được khi mở khoá (POST .../edit) sau khi CLOSED.
  countedCashAmount     BigInt? @map("counted_cash_amount")
  cashDiscrepancyReason String? @map("cash_discrepancy_reason")
  keepForNextAmount     BigInt? @map("keep_for_next_amount")
  handoverNote          String? @map("handover_note")
  // = countedCashAmount - keepForNextAmount, tính lại server-side mỗi lần sửa.
  submittedAmount       BigInt? @map("submitted_amount")

  resolutionMethod CashierShiftDiscrepancyResolution? @map("resolution_method")
  resolutionNote   String?                            @map("resolution_note")
  resolvedBy       String?                            @map("resolved_by") @db.Uuid
  resolvedAt       DateTime?                          @map("resolved_at") @db.Timestamptz(6)

  approvedBy String?   @map("approved_by") @db.Uuid
  approvedAt DateTime? @map("approved_at") @db.Timestamptz(6)

  // Có giá trị ⇒ hiện badge "Đã chỉnh sửa" ở danh sách (chỉ set qua POST .../edit).
  editedBy String?   @map("edited_by") @db.Uuid
  editedAt DateTime? @map("edited_at") @db.Timestamptz(6)

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  cashier  UserAccount   @relation(fields: [tenantId, cashierId], references: [tenantId, id])
  payments Payment[]
  vouchers CashVoucher[]

  @@unique([tenantId, id])
  @@unique([tenantId, shiftNo])
  @@map("cashier_shift")
}

// Dị nguyên đã biết của bệnh nhân (Sprint 4, chốt 2026-08-25) — liên kết `patient` với danh mục
// "Dị nguyên" có sẵn (allergen_catalog, docs/DECISIONS.md #069) thay vì chỉ đọc `allergyNote` tự
// do, phục vụ PRE-03 chính xác hơn. Bảng NỐI có đủ 8 cột bắt buộc (đây LÀ dữ liệu nghiệp vụ chạm
// bệnh nhân, không phải danh mục hệ thống) — allergyNote KHÔNG đổi/xoá, vẫn là ghi chú bổ sung.
model PatientAllergen {
  id         String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  patientId  String @map("patient_id") @db.Uuid
  // FK thường (không composite) tới allergen.id — danh mục toàn hệ thống, không có tenant_id, cùng
  // khuôn diagnosis.icd10Code -> icd10_catalog.
  allergenId String @map("allergen_id") @db.Uuid

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  // Composite FK (tenant_id, patient_id) -> patient(tenant_id, id): chống trỏ chéo tenant.
  patient  Patient  @relation(fields: [tenantId, patientId], references: [tenantId, id])
  allergen Allergen @relation(fields: [allergenId], references: [id])

  @@unique([tenantId, id])
  @@map("patient_allergen")
}

enum FamilyRelation {
  FATHER
  MOTHER
  SIBLING
  PATERNAL_GRANDPARENT
  MATERNAL_GRANDPARENT

  @@map("family_relation")
}

// Bệnh lý nền + thói quen/lối sống của bệnh nhân, dữ liệu có cấu trúc (Sprint 5, thay khối chip
// "Tiền sử bản thân" trong màn Thêm/Sửa bệnh nhân + Tiếp nhận). `patient.personal_history` GIỮ
// NGUYÊN làm ghi chú bổ sung tự do, không đổi/xoá — cùng tinh thần allergyNote/PatientAllergen.
// Thói quen/lối sống (hút thuốc, rượu bia, lười vận động) dùng CHUNG bảng này, mã hoá bằng ICD-10
// Chương XXI "Yếu tố liên quan sức khoẻ" (Z72.0/Z72.1/Z72.3) — KHÔNG tách bảng/cột riêng, tông màu
// chip (rose/amber) chỉ là phân loại hiển thị phía web, không có ý nghĩa gì ở tầng DB.
model PatientCondition {
  id        String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  patientId String @map("patient_id") @db.Uuid
  // FK thường (không composite) tới icd10_catalog.code — danh mục toàn hệ thống, cùng khuôn Diagnosis.icd10Code.
  icd10Code String @map("icd10_code")

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant  Tenant       @relation(fields: [tenantId], references: [id])
  // Composite FK (tenant_id, patient_id) -> patient(tenant_id, id): chống trỏ chéo tenant.
  patient Patient      @relation(fields: [tenantId, patientId], references: [tenantId, id])
  icd10   Icd10Catalog @relation(fields: [icd10Code], references: [code])

  @@unique([tenantId, id])
  @@map("patient_condition")
}

// Tiền sử gia đình có cấu trúc (Sprint 5) — ma trận Quan hệ huyết thống x Bệnh lý (ICD-10) + tuổi
// phát hiện, thay khối "Tiền sử gia đình" text tự do. `patient.family_history` (cột text cũ) GIỮ
// NGUYÊN trong DB, chỉ ngừng đọc/ghi từ UI mới (không có tenant production nào có dữ liệu thật,
// không cần migration dọn dẹp). KHÔNG unique trên (patient, relation, icd10Code) — nhiều người
// thân cùng quan hệ có thể cùng mắc 1 bệnh (vd 2 anh/chị/em ruột), mỗi người 1 dòng riêng.
model PatientFamilyHistory {
  id              String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  patientId       String         @map("patient_id") @db.Uuid
  relation        FamilyRelation
  // FK thường tới icd10_catalog.code, cùng khuôn PatientCondition.icd10Code.
  icd10Code       String         @map("icd10_code")
  ageOfOnsetYears Int?           @map("age_of_onset_years")

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant  Tenant       @relation(fields: [tenantId], references: [id])
  patient Patient      @relation(fields: [tenantId, patientId], references: [tenantId, id])
  icd10   Icd10Catalog @relation(fields: [icd10Code], references: [code])

  @@unique([tenantId, id])
  @@map("patient_family_history")
}

// Append-only — không updated_at, không deleted_at, không version (ngoại lệ đã ghi trong data-model.md).
model AuditLog {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  beforeJson Json?    @map("before_json") @db.JsonB
  afterJson  Json?    @map("after_json") @db.JsonB
  ip         String?
  userAgent  String?  @map("user_agent")
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  // ADM-03 (S5-05) — tra vết theo entity cụ thể (đúng docs/ERD.md mục 5) và theo người dùng.
  @@index([tenantId, entityType, entityId, occurredAt(sort: Desc)])
  @@index([tenantId, actorId, occurredAt(sort: Desc)])
  @@map("audit_log")
}
