// Schema nền tảng — Sprint 1 (xem docs/ERD.md mục 6 "Thứ tự tạo bảng theo sprint").
// Chỉ chứa nhóm bảng "Nền tảng và tenant": tenant, tenant_setting, room, department,
// user_account, role, permission, role_permission, user_role, code_sequence,
// break_glass_session, audit_log, user_session (S1-04, xem docs/DECISIONS.md #019).
// Các bảng patient/appointment/encounter... thuộc Sprint 2-3, chưa thêm ở đây.
//
// RBAC + Data Scope (thay mô hình vai trò cứng) — xem .claude/docs/security-audit.md
// và docs/DECISIONS.md #013-#016.
//
// Quy ước bắt buộc — xem .claude/docs/data-model.md:
// - Mọi bảng nghiệp vụ có đủ 8 cột: id, tenant_id, created_at, updated_at,
//   deleted_at, version, created_by, updated_by.
// - Ngoại lệ: `tenant` không có tenant_id (chính nó là gốc của tenant),
//   `audit_log` không có updated_at/deleted_at/version (append-only).
// - `created_by`/`updated_by` là UUID ghi nhận actor, KHÔNG khai báo @relation
//   (xem docs/DECISIONS.md #005) — tránh vòng phụ thuộc lúc khởi tạo tenant đầu tiên.
// - id dùng uuidv7() (PostgreSQL 18 trở lên, có sẵn trong core) — khớp đúng
//   "UUID v7, sinh phía DB" trong data-model.md. Xem docs/DECISIONS.md #009.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String
  taxCode   String? @map("tax_code")
  address   String?
  licenseNo String? @map("license_no")
  isActive  Boolean @default(true) @map("is_active")

  // Cấu hình "Thông tin phòng khám" (2026-08-13) — phone/email tự do; currency/timezone luôn có
  // giá trị hiển thị (default) nhưng CHƯA nối vào logic tính toán/ngày giờ hệ thống, chỉ lưu
  // trước; logoKey/printLogoKey khoá lưu trên StoragePort, cùng mẫu patient.photoKey.
  phone        String?
  email        String?
  currency     String  @default("VND")
  timezone     String  @default("Asia/Ho_Chi_Minh")
  logoKey      String? @map("logo_key")
  printLogoKey String? @map("print_logo_key")

  // 8 cột bắt buộc (trừ tenant_id — bảng này là gốc của tenant)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenantSettings    TenantSetting[]
  rooms             Room[]
  departments       Department[]
  userAccounts      UserAccount[]
  roles             Role[]
  rolePermissions   RolePermission[]
  codeSequences     CodeSequence[]
  auditLogs         AuditLog[]
  breakGlassSessions BreakGlassSession[]
  userSessions      UserSession[]
  patients          Patient[]
  appointments      Appointment[]

  @@map("tenant")
}

model TenantSetting {
  id        String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  key       String
  valueJson Json   @map("value_json") @db.JsonB

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@map("tenant_setting")
}

model Room {
  id       String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  name     String
  isActive Boolean @default(true) @map("is_active")

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  appointments Appointment[]

  // Đích của composite FK (tenant_id, id) từ appointment (S2-05).
  @@unique([tenantId, id])
  @@map("room")
}

// Khoa/phòng trong 1 tenant — phục vụ Data Scope `department` (security-audit.md).
// v1 phần lớn phòng khám không dùng (1-3 bác sĩ, không chia khoa) nhưng bảng luôn tồn tại.
model Department {
  id       String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  name     String

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  userAccounts UserAccount[]

  // Đích của composite FK (tenant_id, id) từ user_account.
  @@unique([tenantId, id])
  @@map("department")
}

model UserAccount {
  id           String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  departmentId String? @map("department_id") @db.Uuid
  username     String
  passwordHash String  @map("password_hash")
  fullName     String  @map("full_name")
  licenseNo    String? @map("license_no")
  isActive     Boolean @default(true) @map("is_active")

  // Khoá tài khoản tạm sau 5 lần đăng nhập sai trong 15 phút — xem
  // .claude/docs/security-audit.md mục Xác thực, packages/core/src/iam/lockout.ts.
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lastFailedLoginAt DateTime? @map("last_failed_login_at") @db.Timestamptz(6)
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(6)

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  // Composite FK (tenant_id, department_id) -> department(tenant_id, id): department_id
  // nullable nên FK chỉ áp khi có giá trị (Postgres MATCH SIMPLE — xem docs/DECISIONS.md).
  department Department? @relation(fields: [tenantId, departmentId], references: [tenantId, id])
  userRoles  UserRole[]
  sessions   UserSession[]
  appointmentsAsDoctor Appointment[] @relation("AppointmentDoctor")

  // Đích của composite FK (tenant_id, id) từ user_role — chống trỏ chéo tenant (C5 trong ERD.md).
  @@unique([tenantId, id])
  @@unique([tenantId, username])
  @@map("user_account")
}

// Phiên refresh token — cho phép "xoay vòng mỗi lần refresh" (rotation) + phát hiện token bị
// đánh cắp (reuse detection): mỗi lần refresh, phiên cũ bị soft-delete (deleted_reason =
// 'rotated') và trỏ replacedBySessionId sang phiên mới. Nếu một hash đã bị rotate còn bị dùng
// lại, đó là dấu hiệu token rò rỉ — service thu hồi toàn bộ phiên của user (deleted_reason =
// 'reuse_detected'). Thu hồi = soft delete, dùng đúng pattern deleted_at/deleted_reason sẵn có
// trong hệ thống, không cần cột "revoked" riêng. Xem .claude/docs/security-audit.md mục Xác
// thực, docs/DECISIONS.md #019.
model UserSession {
  id               String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  userId           String  @map("user_id") @db.Uuid
  refreshTokenHash String  @unique @map("refresh_token_hash")
  issuedAt         DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt        DateTime @map("expires_at") @db.Timestamptz(6)
  // Composite FK (tenant_id, replaced_by_session_id) -> user_session(tenant_id, id): phiên kế
  // tiếp trong chuỗi rotation, null nếu đây vẫn là phiên hiện hành hoặc đã bị thu hồi thẳng
  // (logout/reuse_detected/role_changed) chứ không phải rotate.
  replacedBySessionId String? @map("replaced_by_session_id") @db.Uuid
  ip                   String? @db.Text
  userAgent            String? @map("user_agent") @db.Text

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])
  // Composite FK (tenant_id, user_id) -> user_account(tenant_id, id): chống trỏ chéo tenant.
  user        UserAccount   @relation(fields: [tenantId, userId], references: [tenantId, id])
  replacedBy  UserSession?  @relation("SessionRotation", fields: [tenantId, replacedBySessionId], references: [tenantId, id])
  previousOf  UserSession[] @relation("SessionRotation")

  @@unique([tenantId, id])
  @@map("user_session")
}

// Vai trò theo tenant (không còn enum cứng) — clinic_admin tạo thêm được vai trò tuỳ biến.
// Seed 5 vai trò mặc định (is_system_default = true) lúc tạo tenant — xem prisma/seed/.
model Role {
  id              String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String  @map("tenant_id") @db.Uuid
  name            String
  isSystemDefault Boolean @default(false) @map("is_system_default")

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  // Đích của composite FK (tenant_id, id) từ user_role/role_permission.
  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@map("role")
}

// Danh mục hành động — TOÀN HỆ THỐNG (giống icd10_catalog), không có tenant_id, seed cố
// định theo code, không do phòng khám tự định nghĩa. Định dạng "<module>.<action>".
model Permission {
  id          String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  module      String
  action      String
  description String

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permission")
}

enum ReferenceCatalogCategory {
  ETHNICITY
  NATIONALITY

  @@map("reference_catalog_category")
}

// Danh mục dùng chung — TOÀN HỆ THỐNG (cùng bản chất permission/icd10_catalog), không có
// tenant_id, không đủ 8 cột bắt buộc, không version (rủi ro ghi đè đồng thời thấp — clinic_admin
// sửa không thường xuyên). Quản lý được qua API (create/update/deactivate) bởi clinic_admin
// (reference_catalog.manage), khác `permission` — vì vậy GRANT mặc định của nexamed_app (SELECT/
// INSERT/UPDATE, đã cấp qua ALTER DEFAULT PRIVILEGES) được giữ nguyên, không REVOKE gì thêm.
// DELETE đã bị revoke toàn cục cho nexamed_app (migration *_tenant_context) — "xoá" thật ra là
// isActive=false (soft), không phải SQL DELETE. `code` là mã chính thức (dân tộc: "1".."54" theo
// Tổng cục Thống kê; quốc tịch: ISO 3166-1 alpha-3) — đây là giá trị lưu trên
// patient.ethnicity/patient.nationality (docs/DECISIONS.md, đảo ngược #034 phần ethnicity/
// nationality — occupation vẫn text tự do, không đổi).
model ReferenceCatalog {
  id        String                    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  category  ReferenceCatalogCategory
  code      String
  name      String
  sortOrder Int                       @default(0) @map("sort_order")
  isActive  Boolean                   @default(true) @map("is_active")

  @@unique([category, code])
  @@map("reference_catalog")
}

// Danh mục hành chính Tỉnh/Phường-Xã — TOÀN HỆ THỐNG (cùng bản chất icd10_catalog/permission),
// không tenant_id, không đủ 8 cột bắt buộc, không version/is_active. Read-only lúc chạy (khác
// reference_catalog — không có endpoint create/update/delete): dữ liệu hành chính chính thức Bộ
// Nội vụ, không ai cần sửa qua UI. `code` phường/xã 8 chữ số duy nhất toàn quốc (không chỉ trong
// phạm vi tỉnh — đã xác nhận không trùng khi soạn seed), nên PK thẳng bằng `code`, không cần FK
// hỗn hợp province_code trong PK. Xem docs/DECISIONS.md #038.
model Province {
  code      String @id
  name      String
  sortOrder Int    @default(0) @map("sort_order")

  wards Ward[]

  @@map("province")
}

model Ward {
  code         String @id
  name         String
  provinceCode String @map("province_code")
  sortOrder    Int    @default(0) @map("sort_order")

  province Province @relation(fields: [provinceCode], references: [code])

  @@index([provinceCode])
  @@map("ward")
}

enum DataScope {
  none
  personal
  department
  global

  @@map("data_scope")
}

// Ma trận phân quyền: (role, permission) -> data_scope. Xem security-audit.md để biết
// bảng giá trị mặc định seed cho 5 vai trò hệ thống.
model RolePermission {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  permissionId String    @map("permission_id") @db.Uuid
  dataScope    DataScope @map("data_scope")

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])
  // Composite FK (tenant_id, role_id) -> role(tenant_id, id): chống trỏ chéo tenant.
  role       Role       @relation(fields: [tenantId, roleId], references: [tenantId, id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([tenantId, roleId, permissionId])
  @@map("role_permission")
}

model UserRole {
  id       String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  roleId   String @map("role_id") @db.Uuid

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  // Composite FK (tenant_id, user_id) -> user_account(tenant_id, id) và
  // (tenant_id, role_id) -> role(tenant_id, id): không thể trỏ sang tenant khác kể cả
  // khi code service sai.
  userAccount UserAccount @relation(fields: [tenantId, userId], references: [tenantId, id])
  role        Role        @relation(fields: [tenantId, roleId], references: [tenantId, id])

  // UNIQUE(tenant_id, user_id, role_id) là PARTIAL (WHERE deleted_at IS NULL) — thêm ở S2-07 khi
  // gán lại vai trò (soft-delete gán cũ + tạo dòng mới) mới thật sự cần: unique thường sẽ chặn
  // gán lại đúng vai trò đã từng bị gỡ trước đó (dòng cũ đã soft-delete vẫn tính vào unique
  // thường). Không khai báo được `@@unique` có `WHERE` bằng Prisma schema (giống C3
  // `patient.national_id_hash`) — viết raw SQL trong migration, không khai báo ở đây.
  @@map("user_role")
}

// Phiên "phá kính" — vượt quyền tạm thời khi bị chặn bởi data_scope. Append-only như
// audit_log (không updated_at/deleted_at/version/created_by/updated_by) — xem
// security-audit.md mục Break-glass.
model BreakGlassSession {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  reason     String
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("break_glass_session")
}

model CodeSequence {
  id           String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  prefix       String
  currentValue BigInt @default(0) @map("current_value")

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, prefix])
  @@map("code_sequence")
}

// Hồ sơ hành chính bệnh nhân (S2-01, PAT-01) — xem .claude/docs/data-model.md, docs/ERD.md.
// `nationalIdEnc`/`nationalIdHash`: mã hoá AES-256-GCM + hash HMAC-SHA256 tra trùng
// (apps/api/src/infrastructure/crypto/pii-encryption.ts), CCCD tuỳ chọn (PAT-01) nên cả hai
// nullable. `addressJson`/`identityVerifiedAt`: thêm ở S2-01 để vá lệch ERD.md/data-model.md
// (docs/DECISIONS.md #024) — `identityVerifiedAt` luôn null ở v1, chuẩn bị cho liên-tenant v3+
// cùng `globalPatientRef`. Unique `(tenantId, nationalIdHash)` WHERE NOT NULL không biểu diễn
// được bằng Prisma schema (partial unique index) — thêm bằng raw SQL trong migration.
model Patient {
  id                 String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  patientCode        String    @map("patient_code")
  fullName           String    @map("full_name")
  dob                DateTime  @db.Date
  gender             String
  phone              String
  nationalIdEnc      Bytes?    @map("national_id_enc")
  nationalIdHash     String?   @map("national_id_hash")
  addressJson        Json?     @map("address_json") @db.JsonB
  allergyNote        String?   @map("allergy_note")
  mergedIntoId       String?   @map("merged_into_id") @db.Uuid
  globalPatientRef   String?   @map("global_patient_ref") @db.Uuid
  identityVerifiedAt DateTime? @map("identity_verified_at") @db.Timestamptz(6)
  // Mở rộng hồ sơ hành chính (docs/DECISIONS.md #034) — tất cả nullable, không backfill, không
  // ràng buộc DB mới. `nationality`/`ethnicity`/`occupation` là text tự do (không có danh mục
  // DB — thiếu nguồn dữ liệu chính thức, cùng lý do đã tạm hoãn ICD-10 ở S3-01).
  // `insuranceNumber` độc lập với module `insurance_card` (S2-04, chưa làm) — chỉ lưu/hiển thị.
  photoKey                String?   @map("photo_key")
  nationalIdIssuedAt      DateTime? @map("national_id_issued_at") @db.Date
  nationalIdIssuedPlace   String?   @map("national_id_issued_place")
  ethnicity               String?
  nationality             String?
  occupation              String?
  insuranceNumber         String?   @map("insurance_number")
  relativeFullName        String?   @map("relative_full_name")
  relativeRelationship    String?   @map("relative_relationship")
  relativePhone           String?   @map("relative_phone")
  relativeAddress         String?   @map("relative_address")
  // Cột dẫn xuất (S2-02, PAT-02) — Postgres GENERATED ALWAYS AS (...) STORED từ full_name (bỏ
  // dấu + viết thường qua hàm nexamed_unaccent_lower(), xem migration `*_patient_search`).
  // KHÔNG bao giờ ghi trực tiếp field này từ Prisma (DB tự tính, ghi vào sẽ lỗi) —
  // PatientRepository không đưa searchKey vào bất kỳ `data: {...}` create/update nào. Khai báo
  // `String?` (không phải `String`) dù thực tế DB không bao giờ null (full_name NOT NULL) — chỉ
  // để Prisma không bắt buộc field này trong `PatientCreateInput`/`PatientUncheckedCreateInput`
  // (Prisma không có khái niệm "generated column, chỉ đọc" nên coi mọi field NOT NULL là bắt
  // buộc phải truyền lúc tạo).
  searchKey          String?   @map("search_key")

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])
  // Composite FK (tenant_id, merged_into_id) -> patient(tenant_id, id): luồng gộp hồ sơ trùng
  // (PAT-04, chưa hiện thực ở S2-01) — bản ghi nguồn không xoá, chỉ trỏ sang bản ghi đích.
  mergedInto Patient?  @relation("PatientMerge", fields: [tenantId, mergedIntoId], references: [tenantId, id])
  mergedFrom Patient[] @relation("PatientMerge")
  appointments Appointment[]

  // Đích của composite FK (tenant_id, id) từ appointment/encounter (S2-05, S3) sau này.
  @@unique([tenantId, id])
  @@unique([tenantId, patientCode])
  @@map("patient")
}

enum AppointmentStatus {
  SCHEDULED
  CANCELLED
  NO_SHOW
  CONVERTED

  @@map("appointment_status")
}

enum AppointmentSource {
  walk_in
  phone
  online

  @@map("appointment_source")
}

// Lịch hẹn (S2-05, APP-01/02/03) — xem .claude/docs/clinical-workflow.md mục "Đặt lịch",
// docs/ERD.md mục 3.3/4. `roomId` nullable: đặt lịch qua điện thoại/online chưa chắc gán phòng
// ngay (module `tenant`/cấu hình phòng là S2-07, chưa tồn tại lúc này) — không phải yêu cầu đã
// chốt, chỉ là lựa chọn ít ràng buộc hơn, dễ siết lại (thêm NOT NULL) hơn là nới lỏng sau.
// Chống trùng giờ bác sĩ (C2, docs/ERD.md mục 4) dùng EXCLUDE USING gist — Prisma không hỗ trợ
// cú pháp EXCLUDE constraint nên thêm bằng raw SQL trong migration, không khai báo được ở đây.
//
// Đổi mô hình đặt lịch (docs/DECISIONS.md #032): không tạo/gắn `patient` lúc đặt — chỉ ghi nhận
// `fullName`/`phone`/`reason` trực tiếp trên `appointment` ("lead capture"), có `bookingCode` để
// khách trình lúc đến. `patientId` chuyển thành nullable — để sẵn cho Tiếp nhận (Sprint 3) gắn
// hồ sơ `patient` thật lúc check-in, chưa có luồng nào ghi giá trị này ở v1 hiện tại.
model Appointment {
  id              String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  patientId       String?           @map("patient_id") @db.Uuid
  doctorId        String            @map("doctor_id") @db.Uuid
  roomId          String?           @map("room_id") @db.Uuid
  bookingCode     String            @map("booking_code")
  fullName        String            @map("full_name")
  phone           String
  reason          String?
  scheduledAt     DateTime          @map("scheduled_at") @db.Timestamptz(6)
  durationMinutes Int               @map("duration_minutes")
  status          AppointmentStatus @default(SCHEDULED)
  source          AppointmentSource
  cancelReason    String?           @map("cancel_reason")

  // 8 cột bắt buộc
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])
  // Composite FK (tenant_id, patient_id/doctor_id/room_id) -> ...(tenant_id, id): chống trỏ chéo
  // tenant (C5, docs/ERD.md mục 4), room_id/patient_id nullable nên FK chỉ áp khi có giá trị.
  patient Patient?    @relation(fields: [tenantId, patientId], references: [tenantId, id])
  doctor  UserAccount @relation("AppointmentDoctor", fields: [tenantId, doctorId], references: [tenantId, id])
  room    Room?       @relation(fields: [tenantId, roomId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, bookingCode])
  @@index([tenantId, phone])
  @@map("appointment")
}

// Append-only — không updated_at, không deleted_at, không version (ngoại lệ đã ghi trong data-model.md).
model AuditLog {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  beforeJson Json?    @map("before_json") @db.JsonB
  afterJson  Json?    @map("after_json") @db.JsonB
  ip         String?
  userAgent  String?  @map("user_agent")
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("audit_log")
}
